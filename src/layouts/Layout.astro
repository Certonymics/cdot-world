---
import "@fontsource-variable/geist";
import "@fontsource-variable/host-grotesk";
import "@fontsource-variable/geist-mono";
import "../styles/tokens.css";
import "../styles/global.css";
import LogoSymbol from "../components/LogoSymbol.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
}
const { title, description, ogTitle, ogDescription } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

/* Structured data. A @graph rather than a single Organization node: the three
   chains are the substance of the product, and as discrete SoftwareApplication
   entities their specifications become extractable facts (a numeric
   `throughput` PropertyValue) instead of prose buried in one description
   string. Keep the figures here in step with the spec chips in index.astro and
   with public/llms.txt. */
const ORG_ID = "https://cdot.world/#certonymity";
const CDOT_ID = "https://cdot.world/#cdot";

/* PropertyValue is schema.org's escape hatch for domain-specific measurements
   that have no dedicated property. Numeric `value` + `unitText` keeps the
   figure machine-comparable; `unitText` alone would force string parsing. */
const spec = (name, value, unitText) =>
  unitText
    ? { "@type": "PropertyValue", name, value, unitText }
    : { "@type": "PropertyValue", name, value };

const layer = (id, name, alternateName, category, description, specs) => ({
  "@type": "SoftwareApplication",
  "@id": `https://cdot.world/#${id}`,
  name,
  alternateName,
  applicationCategory: category,
  operatingSystem: "Any",
  isPartOf: { "@id": CDOT_ID },
  provider: { "@id": ORG_ID },
  description,
  additionalProperty: specs,
});

const graph = [
  {
    "@type": "Organization",
    "@id": ORG_ID,
    name: "Certonymity Ltd",
    legalName: "Certonymity Ltd",
    alternateName: "Certonymity",
    url: "https://cdot.world/",
    logo: "https://cdot.world/assets/logo-512.png",
    email: "info@certonymity.com",
    address: {
      "@type": "PostalAddress",
      streetAddress: "86-87 Campden Street",
      addressLocality: "London",
      postalCode: "W8 7EN",
      addressCountry: "GB",
    },
    description:
      "Certonymity Ltd builds cDot, purpose built blockchain infrastructure for verified identity and money movement at scale.",
  },
  {
    "@type": "SoftwareApplication",
    "@id": CDOT_ID,
    name: "cDot",
    applicationCategory: "FinanceApplication",
    operatingSystem: "Any",
    provider: { "@id": ORG_ID },
    url: "https://cdot.world/",
    description:
      "cDot is the blockchain network built for secure, private, and instant payments. Rather than forcing everything onto a single chain, cDot is a family of purpose-built blockchains, each engineered for what it does best: identity, stablecoin settlement, and trading, interoperating as one trusted network.",
    hasPart: [
      { "@id": "https://cdot.world/#c-layer" },
      { "@id": "https://cdot.world/#p-layer" },
      { "@id": "https://cdot.world/#t-layer" },
    ],
  },
  layer(
    "c-layer",
    "C-Layer",
    "cDot identity and asset recovery chain",
    "SecurityApplication",
    "A purpose-built identity chain for people, businesses, and agents. Cryptographic avatars of verified real identities provide privacy with accountability. Run by nodes around the world for maximum resilience and decentralisation.",
    [
      spec("Throughput", 15000, "tx/s"),
      spec("Finality", 20, "s"),
      spec("Smart contracts", "WASM"),
      spec("Architecture", "Highly parallel"),
      spec("Access", "Permissionless"),
      spec("Visibility", "Public and pseudonymous"),
    ],
  ),
  layer(
    "p-layer",
    "P-Layer",
    "cDot stablecoin and agentic payment chain",
    "FinanceApplication",
    "Engineered for high-throughput, low-cost global settlement and truly programmable money, with native on- and off-ramping. Agentic transactions supported with verifiable, revocable permissions granted by their principals.",
    [
      spec("Throughput", 30000, "tx/s"),
      spec("Finality", "<1", "s"),
      spec("Byzantine security", "45%"),
    ],
  ),
  layer(
    "t-layer",
    "T-Layer",
    "cDot trading chain",
    "FinanceApplication",
    "A high-performance decentralized exchange, offering stablecoin swaps and perpetual futures in a predictable execution environment.",
    [
      spec("Throughput", 30000, "tx/s"),
      spec("Finality", "<1", "s"),
      spec("Architecture", "Native multithreading"),
      spec("Nodes", "Node-permissioned overlay on C-layer"),
      spec("Visibility", "Private and accountable"),
      spec("Matching engine", "Native NASDAQ-like"),
    ],
  ),
];

const orgSchema = { "@context": "https://schema.org", "@graph": graph };
---

<!doctype html>
<!--
     ___ ___       _
    / __|   \ ___ | |_
   | (__| |) / _ \|  _|
    \___|___/\___/ \__|

   Built by Certonymity Ltd.

   You are reading the whole page. No framework runtime, no analytics, no tag
   manager, no third-party scripts, no font CDN. The only JavaScript is a
   contact form and the network map - and that map plots real nodes reporting
   in from real machines, not a decorative loop.

   robots.txt draws a line: retrieval and citation are welcome,
   training is not.
-->
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<!-- Matches --bg-0 so mobile browser chrome does not paint light against the
     dark page. Kept in step with the theme by the script below; the value here
     is the dark default, used until that script runs. -->
<meta name="theme-color" content="#040b18" id="theme-color" />

<!--
  Theme. This script is deliberately BLOCKING and deliberately the first script
  in the document: it has to set data-theme before the browser paints, or a
  visitor who chose light gets a flash of the dark page on every single
  navigation. Moving it below the stylesheet, deferring it, or making it a
  module all reintroduce that flash.

  DARK IS THE UNCONDITIONAL DEFAULT. The site does not follow
  prefers-color-scheme: light is the more common OS default, especially on
  Windows and managed machines, so honouring it meant most first-time visitors
  never saw the design the site was built around. Light is opt-in via the
  toggle, and the attribute is written only for that explicit choice - with
  nothing stored there is no attribute and the base :root palette (dark) applies,
  which is also what JavaScript-disabled visitors get.
-->
<script is:inline>
(function(){
  var KEY = 'cdot-theme';
  /* Duplicates --bg-0 from tokens.css, because the address-bar colour is a meta
     tag and cannot read a custom property. Change both together. */
  var DARK_BG = '#040b18', LIGHT_BG = '#FFFFFF';

  function stored(){
    try {
      var v = localStorage.getItem(KEY);
      return (v === 'light' || v === 'dark') ? v : null;
    } catch (e) { return null; }   /* private mode / storage disabled */
  }

  /* No prefers-color-scheme fallback: unset means dark, always. */
  function effective(){ return stored() || 'dark'; }

  function paint(){
    var s = stored();
    var root = document.documentElement;
    if (s) root.setAttribute('data-theme', s);
    else root.removeAttribute('data-theme');
    /* The address-bar colour is not reachable from CSS, so it is the one value
       that has to be pushed imperatively. */
    var meta = document.getElementById('theme-color');
    if (meta) meta.setAttribute('content', effective() === 'light' ? LIGHT_BG : DARK_BG);
  }

  function set(theme){
    try { localStorage.setItem(KEY, theme); } catch (e) {}
    paint();
  }

  window.__cdotTheme = { stored: stored, effective: effective, paint: paint, set: set };
  paint();
})();
</script>
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta property="og:title" content={ogTitle ?? title} />
<meta property="og:description" content={ogDescription ?? description} />
<meta property="og:url" content={canonical} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="cDot" />
<meta property="og:locale" content="en_GB" />
<meta property="og:image" content={new URL('/assets/og.png', Astro.site).href} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="cDot - secure identity and payments" />
<!-- The only twitter:* tag worth setting: X falls back to the og:* tags for
     title, description and image, but needs this to use the large card. -->
<meta name="twitter:card" content="summary_large_image" />
<script type="application/ld+json" is:inline set:html={JSON.stringify(orgSchema)} />
<link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
<!-- .ico fallback for Safari <15 and crawlers that request /favicon.ico -->
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />
</head>
<body>
<LogoSymbol />
<Header />
<main id="main"><slot /></main>
<Footer />
</body>
</html>
