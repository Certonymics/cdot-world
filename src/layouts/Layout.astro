---
import "@fontsource-variable/geist";
import "@fontsource-variable/host-grotesk";
import "@fontsource-variable/geist-mono";
import "../styles/tokens.css";
import "../styles/global.css";
import LogoSymbol from "../components/LogoSymbol.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { chains, soonChains, joinList, ldDescription, ldProperties } from "../data/network.mjs";
import { company, sites, ORG_ID, tagline } from "../data/company.mjs";
import { faq, ldHtml } from "../data/faq.mjs";
import { lastModified as getLastModified } from "../lib/lastmod.mjs";

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  /* For pages that are not destinations - currently only 404. Suppresses the
     canonical as well as adding the directive: a 404 naming itself canonical is
     asserting that the missing URL is the right one to index. Same contract as
     cdot.app's layout, deliberately. */
  noindex?: boolean;
  /* Blog pages (src/blog/). An article sets og:type to "article", its own social
     image and alt text, its own modified date and an Article node via
     extraSchema; the blog index sets pageType to "CollectionPage". */
  ogType?: "website" | "article";
  ogImage?: string;
  ogImageAlt?: string;
  modified?: string;
  pageType?: string;
  extraSchema?: object[];
}
const {
  title, description, ogTitle, ogDescription, noindex = false,
  ogType = "website", ogImage, ogImageAlt, modified, pageType = "WebPage", extraSchema = [],
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
/* The network and its chains are described on the home page only; other pages
   (the blog, the 404) carry the organisation, the website and themselves. */
const isHome = Astro.url.pathname === "/";

/* Structured data. A @graph rather than a single Organization node: the three
   chains are the substance of the product, and as discrete SoftwareApplication
   entities their specifications become extractable facts (a numeric
   `throughput` PropertyValue) instead of prose buried in one description
   string. The chains' figures and launch status come from src/data/network.mjs,
   the same file the page cards and /llms.txt are built from - change them THERE,
   not here. */
/* dateModified for the WebPage node - see src/lib/lastmod.mjs. */
const lastModified = getLastModified();

const SITE_ID = "https://cdot.world/#website";
const PAGE_ID = `${canonical}#webpage`; /* on the home page: https://cdot.world/#webpage */
const CDOT_ID = "https://cdot.world/#cdot";

/* One SoftwareApplication per chain, built from src/data/network.mjs - the same
   data the page cards and /llms.txt read, so the figures and the launch status
   cannot disagree between them. PropertyValue is schema.org's escape hatch for
   domain-specific measurements with no dedicated property; a numeric `value` plus
   `unitText` keeps a figure machine-comparable where `unitText` alone would force
   a consumer to parse a string. */
const layer = (chain) => ({
  "@type": "SoftwareApplication",
  "@id": `https://cdot.world/#${chain.id}`,
  name: chain.name,
  alternateName: chain.alternateName,
  applicationCategory: chain.category,
  operatingSystem: "Any",
  isPartOf: { "@id": CDOT_ID },
  provider: { "@id": ORG_ID },
  description: ldDescription(chain),
  additionalProperty: ldProperties(chain),
});

const graph = [
  {
    "@type": "Organization",
    /* The company's own node: the same @id certonymity.com publishes (see
       src/data/company.mjs), so this graph and that one are about ONE
       organisation. `url` is the company's site, not this one - this site is the
       network the company builds, not the company. */
    "@id": ORG_ID,
    name: company.legalName,
    legalName: company.legalName,
    alternateName: company.name,
    url: sites.company.url,
    logo: "https://cdot.world/assets/logo-512.png",
    email: company.email,
    identifier: {
      "@type": "PropertyValue",
      propertyID: "Companies House company number",
      value: company.number,
    },
    address: {
      "@type": "PostalAddress",
      streetAddress: company.address.street,
      addressLocality: company.address.locality,
      postalCode: company.address.postcode,
      addressCountry: company.address.country,
    },
    description:
      "Certonymity Ltd builds cDot, the network for verified identity, encrypted communication, instant payments, and programmable money.",
    /* sameAs asserts IDENTITY - "this is the same organisation" - so it holds
       only profiles that are Certonymity itself, and only ones that exist.
       Deliberately NOT here: certonymity.com (that is `url` above), cdot.app (a
       different thing: the product, where this site is the network), and c.email
       (the company's first product). A wrong sameAs is worse than none, because
       it can merge your entity with someone else's. */
    sameAs: [company.linkedin],
    contactPoint: {
      "@type": "ContactPoint",
      contactType: "general enquiries",
      email: company.email,
      availableLanguage: "en",
    },
  },
  {
    "@type": "WebSite",
    "@id": SITE_ID,
    url: "https://cdot.world/",
    name: "cDot",
    description:
      "The home of the cDot network: the concept, the mission, and the open-source work behind it. The cDot app, the product built on the network, is at cdot.app.",
    inLanguage: "en-GB",
    publisher: { "@id": ORG_ID },
  },
  ...(isHome ? [
  {
    "@type": "SoftwareApplication",
    "@id": CDOT_ID,
    name: "cDot",
    applicationCategory: "FinanceApplication",
    operatingSystem: "Any",
    provider: { "@id": ORG_ID },
    url: "https://cdot.world/",
    description:
      "cDot is the network for verified identity, encrypted communication, instant payments, and programmable money. " +
      "Built on the C-Layer, a blockchain for secure, decentralised identity run by independent nodes worldwide, " +
      `with the ${joinList(soonChains().map((c) => `${c.name} (${c.purpose})`))} launching soon as one trusted network.`,
    hasPart: chains.map((c) => ({ "@id": `https://cdot.world/#${c.id}` })),
  },
  ...chains.map(layer),
  ] : []),
];

/* The page node is skipped on the 404: it would assert that a missing URL is a
   page about cDot. relatedLink is how the product site is expressed from here -
   a relationship between pages, not an identity claim - and the matching edge
   (the app being built on this network) belongs in cdot.app's own graph. */
if (!noindex) {
  graph.push({
    "@type": pageType,
    "@id": PAGE_ID,
    url: canonical,
    name: title,
    description,
    inLanguage: "en-GB",
    isPartOf: { "@id": SITE_ID },
    ...(isHome && { about: { "@id": CDOT_ID } }),
    dateModified: modified ?? lastModified,
    relatedLink: [sites.app.url],
  });
  /* The FAQ, from src/data/faq.mjs - the same list the accordion on the page and
     /llms.txt are built from. Home page only: that is where the questions are. */
  if (isHome) {
    graph.push({
      "@type": "FAQPage",
      "@id": "https://cdot.world/#faq",
      url: `${canonical}#faq`,
      isPartOf: { "@id": PAGE_ID },
      inLanguage: "en-GB",
      mainEntity: faq.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: ldHtml(f.a) },
      })),
    });
  }
  graph.push(...extraSchema);
}

const orgSchema = { "@context": "https://schema.org", "@graph": graph };
---

<!doctype html>
<!--
     ___ ___       _
    / __|   \ ___ | |_
   | (__| |) / _ \|  _|
    \___|___/\___/ \__|

   Built by Certonymity Ltd.

   You are reading the whole page. No framework runtime, no analytics, no tag
   manager, no third-party scripts, no font CDN. The only JavaScript is a
   contact form and the network map - and that map plots real nodes reporting
   in from real machines, not a decorative loop.

   robots.txt welcomes every crawler, and /llms.txt is a plain-text summary
   of the network written for them.
-->
<html lang="en-GB">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<!-- Matches --bg-0 so mobile browser chrome does not paint light against the
     dark page. Now that the site is dark-only this is a constant; it duplicates
     --bg-0 from tokens.css because a meta tag cannot read a custom property, so
     change both together. -->
<meta name="theme-color" content="#040b18" />

<title>{title}</title>
<meta name="description" content={description} />
{noindex
  ? <meta name="robots" content="noindex, follow" />
  : <link rel="canonical" href={canonical} />}
<meta property="og:title" content={ogTitle ?? title} />
<meta property="og:description" content={ogDescription ?? description} />
<meta property="og:url" content={canonical} />
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content="cDot" />
<meta property="og:locale" content="en_GB" />
<meta property="og:image" content={ogImage ?? new URL('/assets/og.png', Astro.site).href} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogImageAlt ?? `cDot - ${tagline.toLowerCase()}`} />
<!-- The only twitter:* tag worth setting: X falls back to the og:* tags for
     title, description and image, but needs this to use the large card. -->
<meta name="twitter:card" content="summary_large_image" />
<script type="application/ld+json" is:inline set:html={JSON.stringify(orgSchema)} />
<link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
<!-- .ico fallback for Safari <15 and crawlers that request /favicon.ico -->
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />
</head>
<body>
<LogoSymbol />
<Header />
<main id="main"><slot /></main>
<Footer />
</body>
</html>
