---
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/inter/700.css";
import "@fontsource/darker-grotesque/700.css";
import "@fontsource-variable/geist-mono";
import "../styles/tokens.css";
import "../styles/global.css";
import LogoSymbol from "../components/LogoSymbol.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
}
const { title, description, ogTitle, ogDescription } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Certonymity Ltd",
  legalName: "Certonymity Ltd",
  alternateName: "Certonymity",
  url: "https://www.cdot.world/",
  logo: "https://www.cdot.world/assets/logo-512.png",
  email: "info@certonymity.com",
  address: {
    "@type": "PostalAddress",
    streetAddress: "86-87 Campden Street",
    addressLocality: "London",
    postalCode: "W8 7EN",
    addressCountry: "GB",
  },
  description:
    "cDot is purpose built infrastructure for the next era of money movement and identity at scale: a dedicated identity and asset recovery chain (15,000 tx/s highly parallel, WASM smart contracts, 20 s finality, permissionless, public and pseudonymous, designed for thousands of low hardware nodes worldwide), a stablecoin and agentic payment chain (30,000 tx/s, finality under 1 s, byzantine security 45%), and a trading chain (30,000 tx/s native multithreading, finality under 1 s, ~50 node permissioned overlay on the C-Layer, private and accountable, native NASDAQ-like matching engine), interoperating as one trusted network.",
};
---

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<!-- Matches --bg-0, so mobile browser chrome does not paint light against the
     dark page. -->
<meta name="theme-color" content="#040b18" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta property="og:title" content={ogTitle ?? title} />
<meta property="og:description" content={ogDescription ?? description} />
<meta property="og:url" content={canonical} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="cDot" />
<meta property="og:locale" content="en_GB" />
<meta property="og:image" content={new URL('/assets/og.png', Astro.site).href} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="cDot - secure identity and payments" />
<!-- The only twitter:* tag worth setting: X falls back to the og:* tags for
     title, description and image, but needs this to use the large card. -->
<meta name="twitter:card" content="summary_large_image" />
<script type="application/ld+json" is:inline set:html={JSON.stringify(orgSchema)} />
<link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
<!-- .ico fallback for Safari <15 and crawlers that request /favicon.ico -->
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />
</head>
<body>
<LogoSymbol />
<Header />
<main id="main"><slot /></main>
<Footer />
</body>
</html>
