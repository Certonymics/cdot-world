---
import Layout from "../layouts/Layout.astro";

const title = "Join a group on cDot";
const description =
  "Someone shared a link to a group on cDot. Install the app on your phone, then open the link again to ask to join.";
---

<Layout title={title} description={description} noindex>
  <section class="invite">
    <div class="wrap">
      <p class="eyebrow">Group link</p>
      <h1>Join a group on cDot</h1>
      <p class="sub">Install cDot on your phone, then open this link again to ask to join.</p>
      <div class="hero-ctas">
        <a class="btn btn-primary" id="appstore" href="#" rel="noopener" hidden>Get it on the App Store</a>
        <a class="btn btn-primary" href="https://play.google.com/store/apps/details?id=org.certonym.cdot" rel="noopener">Get it on Google Play</a>
        <a class="btn btn-ghost" href="/">About cDot</a>
      </div>
    </div>
  </section>
  <script is:inline>
    // The App Store listing for org.certonym.cdot. Empty until the app is in
    // the App Store; the button stays hidden while it is.
    const APP_STORE_URL = "";
    if (APP_STORE_URL) {
      const appstore = document.getElementById("appstore");
      appstore.href = APP_STORE_URL;
      appstore.hidden = false;
    }
  </script>
</Layout>
