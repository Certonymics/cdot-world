---
/* Content ported from the certonym.org landing page (LandingPage.jsx: Hero,
 * Benefits, HowCertonymsWork, CodeExample, FAQ). Its NetworkMap and ContactForm
 * are left out - the map already lives on /network, and the site has one
 * contact form, on the homepage, which the CTAs here point at.
 *
 * "Certonym" becomes "cDot" throughout. In practice that copy already said
 * "cDot" almost everywhere; the only Certonym references left were in the code
 * sample's package name, env var and a comment.
 *
 * Rebuilt rather than copied: left-aligned instead of centred, on our tokens
 * rather than a black/opacity ramp, the FAQ is <details>/<summary> instead of
 * React state, and the snippet is a plain <pre> rather than a syntax
 * highlighter - that would be a dependency and a client runtime for colour.
 */
import Layout from "../../layouts/Layout.astro";

const title = "For developers — cDot";
const description =
  "Cut onboarding times and KYC costs with reusable, cross-platform identity verification. Integrate cDot in five minutes and receive proofs instead of storing user data.";

/* Feather icon bodies; the <svg> wrapper lives in the markup. */
const I = {
  userCheck: '<path d="M16 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="8.5" cy="7" r="4"/><polyline points="17 11 19 13 23 9"/>',
  dollar:    '<line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/>',
  code:      '<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>',
  shield:    '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>',
  mail:      '<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>',
  search:    '<circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>',
  user:      '<path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/>',
  check:     '<path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>',
};

const BENEFITS = [
  ["userCheck", "Instant access to verified users",
   "Onboard users in seconds, reduce drop-off at the verification stage, and only run the KYC checks you really need to."],
  ["dollar", "Pay less for user verification",
   "Portable identity proofs mean users already on the network arrive at your signup pre-verified, without you paying for a single check."],
  ["code", "Single integration",
   "Build faster and lighter with a single SDK that covers verification without touching account creation or signup."],
  ["shield", "No data storage",
   "Get cryptographic attribute proofs, not sensitive data. Users share only what you need while you avoid storing their information."],
];

const STEPS = [
  { n: 1, t: "Signup", art: "signup", body: [
    "User signs up to your platform using your existing flow. Your platform calls cDot to check if they’re already verified.",
  ]},
  { n: 2, t: "Verification", art: "scan", body: [
    "If not, the user scans their ID and passes a quick liveness check. They’ll only need to do this once.",
    "If they’re already verified on our network, they skip this step — you automatically have a new, pre-verified user.",
  ]},
  { n: 3, t: "Identity proofs", art: "proofs", body: [
    "User shares proofs of the attributes you need. These proofs can be re-shared with any platform, any time.",
  ]},
];

/* A real TD3 machine-readable zone: two lines of exactly 44 characters, the
   layout an actual passport carries. Made-up holder, and the check digits are
   not computed - it reads as a scan without being a usable specimen. */
const MRZ = [
  "P<GBRMITCHELL<<SARAH<<<<<<<<<<<<<<<<<<<<<<<<",
  "5210293580GBR9001019F3012317<<<<<<<<<<<<<<02",
];

const INTEGRATE = [
  ["1. Get an API key", "Register with us and get your API key from our dashboard."],
  ["2. Copy over our code", "However users register, the signup flow stays yours. All your app needs to do is call the cDot endpoint with the email address and the attributes you need."],
  ["3. Grow your user base", "Users already verified on our network can skip KYC and get onboarded straight away. New users scan a document and pass a liveness check, handled in 30 seconds by cDot."],
  ["4. Store no data", "You receive proofs of the attributes you need without needing to store user data. Later sign-ins remain yours, with no re-verification needed."],
];

const CODE = `import { CDot } from "@certonym/cdot";

const cdot = new CDot({
  baseUrl: process.env.CERTONYM_API_URL!,
  apiToken: process.env.IDV_API_TOKEN,
});

// Start a verification. \`requireLiveness: true\` binds the result to a live
// person - new users run full KYC (document scan + liveness), users who
// already hold an identity skip the scan and only pass liveness.
const result = await cdot.verifications.start({
  email: "ada@example.com",
  requireLiveness: true,
  requestedProofs: ["ageOver18"],
  returnUrl: "https://your-app.example/verify/return",
  webhookUrl: "https://your-app.example/webhook",
});

if (result.kind === "redirect") {
  // Send the user to Certonym; they come back to returnUrl when done.
  console.log("Redirect the user to:", result.redirectUrl);
} else {
  // Proofs were already on-chain - no user interaction needed.
  console.log("Verified immediately:", result.sessionId, result.ageProof);
}`;

/* Static syntax highlighting, matching the GitHub-light theme the original
   block uses (codeBlockTheme.js: comments #6e7781 italic, keywords #bc4c00,
   strings #0a3069, properties #0e7490, class names #116329, numbers and
   booleans #0550ae, functions #8250df). Tokenised here at build time rather
   than by react-syntax-highlighter, which would be a dependency and a client
   runtime for something that never changes after the build.

   Each line is walked once, left to right, rather than run through a stack of
   replaces. Comments and strings have to be taken as whole spans - they can
   contain anything, and a keyword pass over the raw line would recolour the
   word "const" inside an English sentence in a comment. The remaining code is
   then matched by ONE alternation, so no rule can strike inside the markup an
   earlier rule just emitted. */
const esc = (t) => t.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");

/* Deliberately sparing, because Prism is. Everything not listed here stays the
   base #24292f: class names like CDot, object keys like `baseUrl:`, and
   property access like `result.redirectUrl` are all plain in the original, and
   colouring them made the block far busier than the page it came from.

   SCREAMING_CASE is matched by requiring the whole run to be upper-case, which
   is what separates a constant (CERTONYM_API_URL, blue) from a class name
   (CDot, plain) without needing to know anything about either. */
const TOKENS = new RegExp(
  [
    "\\b(import|from|const|let|var|new|await|async|return|if|else|function|export|default|typeof|instanceof)\\b",
    "\\b(true|false|null|undefined|\\d+)\\b",
    "\\b([A-Z][A-Z0-9_]*)\\b",            // constants only - CDot does not match
    /* Call sites, lower-case initial only. A capitalised one is a constructor
       (`new CDot({`), which the original leaves plain rather than tinting like
       a method. */
    "\\b([a-z_$][\\w$]*)(?=\\s*\\()",
  ].join("|"),
  "g",
);

const code_tokens = (chunk) =>
  esc(chunk).replace(TOKENS, (m, kw, num, konst, fn) =>
    kw    ? `<span class="c-kw">${kw}</span>`
    : num   ? `<span class="c-num">${num}</span>`
    : konst ? `<span class="c-num">${konst}</span>`
    : fn    ? `<span class="c-fn">${fn}</span>`
    : m,
  );

function highlight(code) {
  return code.split("\n").map((line) => {
    let out = "";
    let i = 0;
    while (i < line.length) {
      if (line.startsWith("//", i)) {
        out += `<span class="c-com">${esc(line.slice(i))}</span>`;
        break;
      }
      if (line[i] === '"') {
        let j = i + 1;
        while (j < line.length && line[j] !== '"') j += line[j] === "\\" ? 2 : 1;
        out += `<span class="c-str">${esc(line.slice(i, j + 1))}</span>`;
        i = j + 1;
        continue;
      }
      let j = i;
      while (j < line.length && line[j] !== '"' && !line.startsWith("//", j)) j++;
      out += code_tokens(line.slice(i, j));
      i = j;
    }
    return out;
  });
}

const CODE_LINES = highlight(CODE);

const FAQ = [
  { q: "What is cDot?", html: `
    <p>cDot is a tool that gives people reusable identity proofs that they can use to verify across different platforms.</p>
    <p>This allows platforms and businesses to cut onboarding times and verification costs, and users to avoid having to repeatedly prove the same facts about themselves and expose their personal data.</p>
    <p>cDot was created by the team behind <a href="https://c.email/" target="_blank" rel="noopener noreferrer">c.Email</a> &mdash; encrypted, authenticated email that works with your existing address.</p>` },
  { q: "How does cDot work?", html: `
    <p>Users sign up to your platform however you choose. One API call tells you whether their email address has already been verified elsewhere on our network. If it has, a quick face match confirms it&rsquo;s the same person, with no document scan or full verification needed. Only unverified users complete a full ID check, and they only ever do it once.</p>
    <p>Users who&rsquo;ve used any of them arrive at your signup already verified: the pool of pre-verified customers grows without you paying for a single check.</p>
    <p>For users, this means going from registered to verified in seconds instead of minutes. For platforms, it means lower verification bills and reduced user drop-off.</p>` },
  { q: "How is cDot different to traditional identity verification?", html: `
    <p>Under the status quo model of online identity, verification is endlessly repeated and over-discloses. Generally, it requires users to hand over a copy of their ID to every platform that asks for it. This means they hand over more data than they need to centralised platforms, and platforms themselves take on unwanted and unnecessary liability for data protection, as well as expensive KYC processes.</p>
    <p>Often, too many documents are required to prove a single identity, thanks to different ID types, renewed or new documents, name or address changes, and so on. People lack the ability to manage their digital identity in a single place.</p>
    <p>We think this model is fundamentally broken, so we created cDot as a secure, efficient, privacy-first alternative.</p>` },
  { q: "How do I get started?", html: `
    <p>Integrating or building with cDot is easy. <a href="/#contact">Contact us</a> to get a demo, or get an API key straight away, then copy <a href="#integration">the lines of code above</a>.</p>` },
];
---

<Layout title={title} description={description}>

<div class="page-hero">
  <div class="wrap">
    <h1>Secure identity for any platform</h1>
    <p class="sub">Cut onboarding times and KYC costs with reusable, cross-platform identity verification.</p>
    <div class="hero-ctas">
      <a class="btn btn-primary" href="#integration">See integration</a>
      <a class="btn btn-ghost" href="https://agepass.xyz/" target="_blank" rel="noopener noreferrer">Explore demo</a>
    </div>
  </div>
</div>

<section id="benefits">
  <div class="wrap">
    <h2>Onboard users faster with portable digital identities</h2>
    <p class="lead">Build with cDot and receive instant proofs instead of storing user data.</p>
    <div class="ben-grid">
      {BENEFITS.map(([ic, t, b]) => (
        <article class="ben">
          {/* aria-hidden: the icon restates the heading below it, so announcing
              it would only double up. */}
          <span class="ben-ic"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={I[ic]} /></span>
          <h3>{t}</h3>
          <p>{b}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<div class="divider"></div>

<section id="how-it-works">
  <div class="wrap">
    <h2>How it works</h2>
    <p class="lead">Get instant identity proofs for pre-verified users instead of running KYC checks.</p>

    <div class="stp-grid">
      {STEPS.map((s) => (
        <article class="stp">
          {/* Every illustration is plain elements rather than inputs or
              buttons, so nothing inside what is really a picture is focusable
              or announced as a control. */}
          <div class="stp-art" aria-hidden="true">
            <div class="stp-card">
              {s.art === "signup" && (
                <div class="ill">
                  <p class="ill-lbl">Email</p>
                  <div class="ill-row">
                    <span class="ill-field">
                      <svg viewBox="0 0 24 24" set:html={I.mail} />
                      <em>sarah.mitchell@email.com</em>
                    </span>
                    <span class="ill-btn">Sign up</span>
                  </div>
                  <div class="ill-lookup">
                    <svg viewBox="0 0 24 24" set:html={I.search} />
                    <span>Searching for verified identity&hellip;</span>
                  </div>
                </div>
              )}

              {s.art === "scan" && (
                <div class="ill">
                  <div class="ill-doc">
                    <div class="ill-doc-top">
                      <span class="ill-portrait"><svg viewBox="0 0 24 24" set:html={I.user} /></span>
                      {/* Redacted bars, not legible text: the MRZ is the point
                          of the card, and real-looking data up here competes. */}
                      <span class="ill-bars"><i></i><i></i><i></i></span>
                    </div>
                    <div class="ill-mrz">
                      {MRZ.map((l) => <p>{l}</p>)}
                    </div>
                  </div>
                  <p class="ill-done"><svg viewBox="0 0 24 24" set:html={I.check} />Document scanned</p>
                </div>
              )}

              {s.art === "proofs" && (
                <div class="ill">
                  <ul class="ill-attrs">
                    {["Over 21", "UK resident"].map((a) => (
                      <li><span>{a}</span><em><svg viewBox="0 0 24 24" set:html={I.check} />Proved</em></li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          </div>
          <div class="stp-body">
            <p class="stp-n">Step {s.n}</p>
            <h3>{s.t}</h3>
            {s.body.map((p) => <p>{p}</p>)}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<div class="divider"></div>

<section id="integration">
  <div class="wrap">
    <h2>Integrate cDot in 5 minutes</h2>
    <p class="lead">Get started with just a few lines of code.</p>

    <div class="int-grid">
      <ol class="int-steps">
        {INTEGRATE.map(([t, b]) => (
          <li>
            <p class="int-t">{t}</p>
            <p class="int-b">{b}</p>
          </li>
        ))}
      </ol>
      <div class="code">
        {/* Sits over the code rather than in a header bar, and outside the
            scrolling area so it stays put when the code is scrolled sideways.
            Icon-only: a labelled button is wide enough to cover the first
            line. Matches the original block. */}
        <button class="code-copy" type="button" aria-label="Copy code" title="Copy code">
          <svg class="i-copy" viewBox="0 0 24 24" aria-hidden="true">
            <rect x="9" y="9" width="13" height="13" rx="2"/>
            <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/>
          </svg>
          <svg class="i-done" viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
        </button>
        {/* Line numbers are a generated column, not characters in the text, so
            selecting the code copies the code and not the gutter. */}
        <pre tabindex="0"><code>{CODE_LINES.map((l) => (
          <span class="c-line"><i aria-hidden="true"></i><span set:html={l || "&nbsp;"} /></span>
        ))}</code></pre>
      </div>
    </div>
  </div>
</section>

<div class="divider"></div>

<section id="faq">
  <div class="wrap">
    <h2>FAQ</h2>
    <p class="lead">Find out more about cDot.</p>
    <div class="faq">
      {FAQ.map((f) => (
        <details class="faq-item">
          <summary>
            <span>{f.q}</span>
            <span class="faq-mark" aria-hidden="true"></span>
          </summary>
          <div class="faq-a" set:html={f.html} />
        </details>
      ))}
    </div>
    <p class="lead faq-foot">Still have questions? <a href="/#contact">Get in touch</a>.</p>
  </div>
</section>

</Layout>

<style>
  /* --- benefits ----------------------------------------------------------- */
  .ben-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;margin-top:36px}
  @media(max-width:1000px){.ben-grid{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:560px){.ben-grid{grid-template-columns:1fr}}
  .ben{
    display:flex;flex-direction:column;
    border:1px solid var(--line);border-radius:16px;padding:22px;background:var(--card);
  }
  .ben-ic{
    width:44px;height:44px;border-radius:12px;margin-bottom:18px;
    display:flex;align-items:center;justify-content:center;flex-shrink:0;
    background:rgba(var(--brand-rgb),.10);color:var(--cyan);
  }
  .ben-ic svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:2;
    stroke-linecap:round;stroke-linejoin:round}
  .ben h3{font-size:17px;font-weight:600;line-height:1.35;margin-bottom:10px}
  .ben p{color:var(--ink-dim);font-size:14.5px;line-height:1.6}

  /* --- how it works ------------------------------------------------------- */
  .stp-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:36px}
  @media(max-width:900px){.stp-grid{grid-template-columns:1fr}}
  .stp{
    display:flex;flex-direction:column;overflow:hidden;
    border:1px solid var(--line);border-radius:18px;background:var(--card);
  }
  .stp-art{
    position:relative;min-height:220px;display:flex;align-items:center;
    justify-content:center;padding:24px;background:rgba(var(--brand-rgb),.07);
  }
  /* The dotted field, from the original - it is what makes the panel read as a
     surface rather than a flat block. */
  .stp-art::before{
    content:"";position:absolute;inset:0;pointer-events:none;
    background-image:radial-gradient(circle,rgba(var(--brand-rgb),.28) 1px,transparent 1px);
    background-size:8px 8px;
  }
  .stp-card{position:relative;width:100%;max-width:262px}
  .stp-body{padding:22px}
  .stp-n{font-size:12px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;
    color:var(--cyan);margin-bottom:8px}
  .stp-body h3{font-size:17.5px;font-weight:600;line-height:1.35;margin-bottom:10px}
  .stp-body p{color:var(--ink-dim);font-size:14.5px;line-height:1.65;margin-bottom:10px}
  .stp-body p:last-child{margin-bottom:0}

  /* --- the three illustrations -------------------------------------------- */
  .ill{border:1px solid rgba(var(--brand-rgb),.25);border-radius:13px;padding:14px;
    background:rgba(var(--veil-rgb),.6)}
  .ill-lbl{font-size:11px;font-weight:500;color:var(--ink-faint);margin-bottom:6px}
  .ill-row{display:flex;gap:8px}
  .ill-field{
    flex:1;min-width:0;display:flex;align-items:center;gap:6px;
    border:1px solid rgba(var(--brand-rgb),.25);border-radius:8px;
    background:var(--bg-0);padding:7px 9px;
  }
  .ill-field svg{width:13px;height:13px;flex-shrink:0;fill:none;stroke:var(--cyan);stroke-width:2}
  .ill-field em{font-style:normal;font-size:11px;color:var(--ink-dim);
    overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .ill-btn{flex-shrink:0;border-radius:8px;background:var(--brand-strong);color:#fff;
    font-size:11px;font-weight:500;padding:7px 12px}
  .ill-lookup{
    display:flex;align-items:center;gap:8px;margin-top:11px;
    border:1px solid rgba(var(--brand-rgb),.3);border-radius:8px;
    background:rgba(var(--veil-rgb),.7);padding:9px;
  }
  .ill-lookup svg{width:13px;height:13px;flex-shrink:0;fill:none;stroke:var(--cyan);stroke-width:2}
  .ill-lookup span{font-size:11px;line-height:1.35;color:var(--ink-dim)}

  .ill-doc{border:1px solid rgba(var(--brand-rgb),.2);border-radius:9px;
    background:rgba(var(--veil-rgb),.75);padding:9px}
  .ill-doc-top{display:flex;gap:9px}
  .ill-portrait{
    width:40px;height:52px;flex-shrink:0;border-radius:4px;
    border:1px solid rgba(var(--brand-rgb),.25);background:rgba(var(--brand-rgb),.08);
    display:flex;align-items:center;justify-content:center;
  }
  .ill-portrait svg{width:20px;height:20px;fill:none;stroke:var(--cyan);stroke-width:1.8}
  .ill-bars{flex:1;min-width:0;display:flex;flex-direction:column;justify-content:center;gap:6px}
  .ill-bars i{display:block;height:6px;border-radius:99px;background:rgba(var(--brand-rgb),.3)}
  .ill-bars i:nth-child(2){width:80%}
  .ill-bars i:nth-child(3){width:60%}
  /* The scan frame: corner brackets on the band's outside edges, and a sweep
     line placed over the glyphs rather than displacing them. */
  .ill-mrz{position:relative;margin-top:9px;overflow:hidden;border-radius:4px;
    border:1px solid rgba(var(--brand-rgb),.4);background:var(--bg-0);padding:4px 6px}
  .ill-mrz::before{content:"";position:absolute;left:0;right:0;top:50%;height:1px;
    background:rgba(var(--brand-rgb),.7)}
  .ill-mrz p{font-family:var(--font-mono);font-size:6.5px;line-height:1.5;
    letter-spacing:.02em;white-space:pre;color:var(--ink-dim)}
  .ill-done{display:inline-flex;align-items:center;gap:6px;margin-top:10px;
    font-size:12px;font-weight:600;color:var(--cyan)}
  .ill-done svg{width:13px;height:13px;flex-shrink:0;fill:none;stroke:currentColor;stroke-width:2}

  .ill-attrs{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:8px}
  .ill-attrs li{
    display:flex;align-items:center;justify-content:space-between;gap:8px;
    border:1px solid rgba(var(--brand-rgb),.15);border-radius:8px;
    background:rgba(var(--veil-rgb),.75);padding:8px 11px;
  }
  .ill-attrs span{font-size:13px;font-weight:500;color:var(--ink)}
  .ill-attrs em{font-style:normal;display:inline-flex;align-items:center;gap:5px;
    font-size:11.5px;font-weight:600;color:var(--cyan)}
  .ill-attrs em svg{width:13px;height:13px;flex-shrink:0;fill:none;stroke:currentColor;stroke-width:2}

  /* --- integration -------------------------------------------------------- */
  /* This section runs wider than the site's 1080px wrap, as it does on
     certonym.org. The snippet's longest line is a ~76-character comment
     needing about 550px at 12px mono, and at the standard width the two
     columns could not both clear that - the listing scrolled sideways from the
     moment it loaded, or the steps were squeezed to pay for it. */
  #integration .wrap{max-width:1200px}
  /* start, not center. The original centres the shorter column, which puts the
     first step level with the middle of the listing; here the two begin on the
     same line, so step 1 reads against the import it describes. */
  .int-grid{display:grid;grid-template-columns:0.85fr 1fr;gap:48px;align-items:start;margin-top:36px}
  @media(max-width:900px){.int-grid{grid-template-columns:1fr;gap:32px}}
  .int-steps{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:20px}
  .int-t{font-weight:600;color:var(--cyan);font-size:15.5px;margin-bottom:5px}
  .int-b{color:var(--ink-dim);font-size:15px;line-height:1.65}

  /* The block keeps the original's own light theme in both schemes. It is a
     code listing, not site chrome - editors and docs keep their own palette,
     and the GitHub-light token colours below are only legible on white. */
  .code{
    position:relative;border:1px solid #d0d7de;border-radius:16px;overflow:hidden;
    background:#fff;box-shadow:var(--shadow-card);
  }
  .code-copy{
    position:absolute;top:8px;right:8px;z-index:2;
    display:flex;align-items:center;justify-content:center;width:28px;height:28px;
    border:1px solid #d0d7de;border-radius:8px;background:rgba(255,255,255,.9);
    backdrop-filter:blur(4px);color:#6e7781;cursor:pointer;padding:0;
    transition:color .2s,background-color .2s;
  }
  .code-copy:hover{color:#24292f;background:#f3f4f6}
  .code-copy:focus-visible{outline:2px solid var(--cyan);outline-offset:1px}
  .code-copy svg{width:14px;height:14px;fill:none;stroke:currentColor;stroke-width:2;
    stroke-linecap:round;stroke-linejoin:round}
  .code-copy .i-done{display:none;color:#116329}
  .code-copy.is-done .i-copy{display:none}
  .code-copy.is-done .i-done{display:block}

  /* tabindex on the <pre> so a keyboard user can reach and scroll it: the
     listing overflows on narrow screens and would otherwise be unreachable. */
  .code pre{overflow-x:auto;padding:16px 0;margin:0}
  .code pre:focus-visible{outline:2px solid var(--cyan);outline-offset:-2px}
  .code code{display:block;font-family:var(--font-mono);font-size:12px;
    line-height:1.55;color:#24292f;white-space:pre}
  .c-line{display:block}
  /* counter rather than typed-out digits, so a copy takes the code alone. */
  .code code{counter-reset:ln}
  .c-line i{
    counter-increment:ln;display:inline-block;width:2.25em;padding-right:1em;
    text-align:right;color:#8c959f;user-select:none;font-style:normal;
  }
  .c-line i::before{content:counter(ln)}

  /* GitHub-light token colours, from the original's codeBlockTheme.js.
     :global() is load-bearing. These spans are injected with set:html, and
     Astro only stamps its scoping attribute onto elements it renders itself -
     so scoped selectors here match nothing at all, and the whole listing comes
     out plain black with upright comments. */
  .code :global(.c-com){color:#6e7781;font-style:italic}
  .code :global(.c-kw){color:#bc4c00}
  .code :global(.c-str){color:#0a3069}
  .code :global(.c-num){color:#0550ae}
  .code :global(.c-fn){color:#8250df}
</style>

<script is:inline>
(function(){
  var btn = document.querySelector('.code-copy');
  if (!btn || !navigator.clipboard) return;
  var pre = btn.parentElement.querySelector('pre');
  var reset;

  btn.addEventListener('click', function(){
    /* innerText, not textContent: the line numbers are generated by a CSS
       counter and so are absent from both, but innerText also keeps the line
       breaks that textContent would flatten. */
    navigator.clipboard.writeText(pre.innerText).then(function(){
      btn.classList.add('is-done');
      btn.setAttribute('aria-label', 'Copied');
      btn.setAttribute('title', 'Copied');
      clearTimeout(reset);
      reset = setTimeout(function(){
        btn.classList.remove('is-done');
        btn.setAttribute('aria-label', 'Copy code');
        btn.setAttribute('title', 'Copy code');
      }, 2000);
    });
  });
})();
</script>
