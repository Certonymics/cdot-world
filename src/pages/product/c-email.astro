    .s4-vis{transition:opacity .2s ease;transform:none}
  }

  @media(max-width:900px){
    /* Stacked: the panel still sticks, just above the steps rather than
       beside them, so it stays in view as they pass. */
    .s4{grid-template-columns:1fr;gap:20px}
    .s4-col{top:88px;height:auto}
    .s4-stage{min-height:240px;padding:26px}
    .s4-step{min-height:62vh}
    .s4-n,.s4-b{font-size:15.5px}
  }

  /* The four screens. Light in both themes, like every other app mockup. */
  .hv-tiles{display:flex;align-items:center;justify-content:center;gap:14px}
  .hv-tiles span{width:56px;height:56px;border-radius:12px;display:flex;
