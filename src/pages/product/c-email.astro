  /* --- How it works: sticky screen, steps scrolling past ----------------- */
  .s4{display:grid;grid-template-columns:1fr 1fr;gap:64px;margin-top:36px}
  /* Each step is about a screenful tall, so exactly one of them owns the
     middle of the view at a time - which is what the observer keys off. */
  .s4-step{
    min-height:calc(100svh - 8rem);display:flex;flex-direction:column;
    justify-content:center;border-bottom:1px solid var(--line);
  }
  .s4-steps{list-style:none;margin:0;padding:0}
  .s4-step:last-child{border-bottom:0}
  .s4-n{font-weight:600;color:var(--cyan);font-size:17px;margin-bottom:10px}
  .s4-b{color:var(--ink-dim);font-size:17px;line-height:1.65;max-width:34rem}

