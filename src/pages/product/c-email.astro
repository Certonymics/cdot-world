<script is:inline>
(function(){
  var tabs = Array.prototype.slice.call(document.querySelectorAll('.why-tab'));
  if (!tabs.length) return;
  var vis  = Array.prototype.slice.call(document.querySelectorAll('.why-vis'));
  var txt  = Array.prototype.slice.call(document.querySelectorAll('.why-text'));

  function select(i, focus){
    tabs.forEach(function(t, n){
      var on = n === i;
      t.setAttribute('aria-selected', on ? 'true' : 'false');
      /* Roving tabindex: the list is one tab stop and arrows move within it. */
      t.tabIndex = on ? 0 : -1;
      if (on && focus) t.focus();
    });
    vis.forEach(function(v, n){ v.classList.toggle('is-on', n === i); });
    txt.forEach(function(p, n){ p.classList.toggle('is-on', n === i); });
  }

  tabs.forEach(function(t, i){
    t.addEventListener('click', function(){ select(i, false); });
  });

  document.querySelector('.why-tabs').addEventListener('keydown', function(e){
    var i = tabs.findIndex(function(t){ return t.getAttribute('aria-selected') === 'true'; });
    if (i < 0) return;
    var next = e.key === 'ArrowDown' || e.key === 'ArrowRight' ? i + 1
             : e.key === 'ArrowUp'   || e.key === 'ArrowLeft'  ? i - 1
             : e.key === 'Home' ? 0
             : e.key === 'End'  ? tabs.length - 1
             : -1;
    if (next === -1) return;
    e.preventDefault();
    select((next + tabs.length) % tabs.length, true);
  });
})();
</script>

<script is:inline>
(function(){
  var steps = Array.prototype.slice.call(document.querySelectorAll('.s4-step'));
  var vis   = Array.prototype.slice.call(document.querySelectorAll('.s4-vis'));
  if (!steps.length || !vis.length) return;

  function show(i){
    vis.forEach(function(v, n){ v.classList.toggle('is-on', n === i); });
  }

  /* No IntersectionObserver - and more importantly no JS at all - leaves the
     first screen showing and the copy entirely readable, so the section
     degrades to a plain illustrated list rather than to nothing. */
  if (!('IntersectionObserver' in window)) return;

  /* A band one pixel high across the middle of the viewport: a step counts as
     current the moment it crosses the centre line, which is what keeps the
     swap in step with reading rather than with the top edge of the section. */
  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if (e.isIntersecting) show(steps.indexOf(e.target));
    });
  }, { rootMargin: '-50% 0px -50% 0px', threshold: 0 });

  steps.forEach(function(el){ io.observe(el); });
})();
</script>
