    align-items:center;justify-content:center;background:rgba(86,106,253,.15)}
  .hv-ic svg{fill:none;stroke:#566afd}
  .hv-txt{flex:1;min-width:0;display:flex;flex-direction:column}
  .hv-txt b{font-size:11px;font-weight:600;color:rgba(0,0,0,.8)}
  .hv-txt i{font-style:normal;font-size:10px;color:rgba(0,0,0,.45)}
  .hv-ok{flex-shrink:0}

  .hv-did{border:1px solid rgba(86,106,253,.25);border-radius:12px;
    background:rgba(235,245,255,.55);padding:14px}
  .hv-did-head{display:flex;align-items:center;gap:8px;padding-bottom:11px;margin-bottom:11px;
    border-bottom:1px solid rgba(86,106,253,.15);color:#566afd}
  .hv-did-head b{font-size:12px;font-weight:600;color:rgba(0,0,0,.8)}
  .hv-did-row{display:flex;align-items:center;justify-content:space-between;gap:12px;
    font-size:11px;margin-top:9px}
  .hv-did-row:first-of-type{margin-top:0}
  .hv-did-row span{flex-shrink:0;color:rgba(0,0,0,.5)}
  .hv-did-row b{font-weight:500;color:rgba(0,0,0,.8);text-align:right}

  .hv-levels{display:flex;flex-direction:column;gap:9px}
