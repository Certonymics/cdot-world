  .hv-level b{font-size:10.5px;font-weight:700;letter-spacing:.04em;color:#566afd}
  .hv-level i{font-style:normal;font-size:10px;line-height:1.35;color:rgba(86,106,253,.8)}
  .hv-level.warn b{color:#ff7300}
