  }

  /* One box, all six screens stacked inside it: sizing to the tallest keeps
     the panel from resizing as the selection moves. */
  .why-stage{
    position:relative;display:grid;place-items:center;
    width:260px;min-height:200px;padding:36px;
    border:1px solid var(--line);border-radius:18px;background:var(--bg-0);
