---
import Layout from "../layouts/Layout.astro";

/* These track the header tagline and the hero, which are what a visitor sees
   first - a search result or a shared card that reads differently from the page
   behind it looks like a different product. NOTE: public/assets/og.png still has
   the OLD tagline ("Secure identity and payments") baked in as pixels, so the
   card art and the card text now disagree. Regenerate the image to close it. */
const title = "cDot: Secure identity, communication and payments";
const description =
  "cDot is the network for verified identity, encrypted communication, instant payments, and programmable money. Join today by downloading the app or running a node.";
const ogTitle = "cDot — Secure identity, communication and payments";
const ogDescription =
  "cDot is the network for verified identity, encrypted communication, instant payments, and programmable money. Built on the C-Layer: the blockchain for secure, decentralised identity, run by independent nodes worldwide.";
---

<Layout title={title} description={description} ogTitle={ogTitle} ogDescription={ogDescription}>

<div class="hero">
  <div class="watermark" aria-hidden="true">
    <img src="/assets/Calque_1.svg" alt="" width="283" height="338" decoding="async">
  </div>
  <div class="wrap">
    <h1>The infrastructure for <span class="glow">the&nbsp;internet as it should have been</span>.</h1>
    <p class="sub">cDot is the network for verified identity, encrypted communication, instant payments, and programmable money. Join today by downloading the app or running a node.</p>
    <div class="hero-ctas">
      <a class="btn btn-primary" href="#c-layer">Run a node</a>
      <!-- Outbound, so it takes the same target/rel treatment as the other
           c.email links in the header and footer. -->
      <a class="btn btn-ghost" href="https://c.email/" target="_blank" rel="noopener noreferrer">See it in action</a>
    </div>
  </div>
</div>

<section id="mission">
  <div class="wrap">
    <h2>Secure, private, and scalable.</h2>
    <p class="lead">cDot is the blockchain network built for secure, private, and instant interactions between verified parties — whether in the form of email, messaging, payments, or trades.</p>
    <p class="lead">Using cryptographic pseudonyms of real verified identities, cDot ensures every communication or transaction is both private and accountable.</p>

    <h2 class="h2-sub">Where value is exchanged between people, businesses, and machines.</h2>
    <p class="lead">Stablecoins enable instant, borderless, programmable transactions — but today's blockchains aren't designed for them. Existing systems are either fully general or optimised for trading, and none were built to integrate identity with payments.</p>
    <p class="lead">Transactions at scale don't just need speed and low cost. They need verifiable identity on both sides, including a system for identity that can account for the AI agents increasingly transacting on behalf of people and businesses. With decentralised identity, stablecoin payments, and agent permissions, cDot exists to close the gap.</p>
    <!-- Formerly the standalone "Use cases" section, folded in here. The prose
         runs unbroken above and the pill list closes the section: it is a list
         of examples for the argument, so it reads as the argument's conclusion
         rather than an interruption partway through it. -->
    <div class="uses">
      <span class="use">Encrypted email and chat</span>
      <span class="use">Anonymous age verification</span>
      <span class="use">Verifiable credentials</span>
      <span class="use">Global payments</span>
      <span class="use">Embedded finance</span>
      <span class="use">Microtransactions</span>
      <span class="use">Agentic payments</span>
      <span class="use" title="Never lose your self custodied crypto">Asset recovery</span>
    </div>
  </div>
</section>

<!-- One section covers the whole C-Layer story. The map comes first - it is
     the evidence that the network exists - and the three chains follow as the
     detail of what runs on it. There is no separate #network section: it said
     "one network" and then sat apart from the thing it was describing. -->
<section id="c-layer">
  <div class="wrap">
    <h2>The identity layer for the next generation of the internet.</h2>
    <p class="lead">cDot is built on the C-Layer: the blockchain for secure, decentralised identity, with no single point of failure. Anyone can run a node — sign up to secure the network and earn points redeemable for CDOT tokens.</p>
    <!-- Signup sits ABOVE the map. The map is evidence for the invitation, not a
         preamble to it: a reader who is already sold should not have to scroll
         past a world map to find the field. Its own copy line was folded into
         the standfirst above rather than repeated here. -->
    <div class="node-signup">
      <form class="node-form" id="clayerForm" name="clayer-nodes">
        <!-- A placeholder is not a label: it vanishes on first keystroke and many
             screen readers skip it entirely. Visually hidden, still announced. -->
        <label class="sr-only" for="clayer-email">Email address</label>
        <input id="clayer-email" type="email" name="email" autocomplete="email"
               placeholder="name@company.com" required>
        <!-- Honeypot: hidden from people, filled in by bots. -->
        <input class="cf-honeypot" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true">
        <button class="btn btn-primary" type="submit">Register your interest</button>
      </form>
      <p class="node-status" id="clayer-status" role="status" aria-live="polite"></p>
    </div>
    <div class="maplive">
      <div class="mapcard">
        <div class="mapvp" id="mapvp">
          <!-- Constant-size dotted-land texture. Deliberately OUTSIDE #maplayer so
               it is never CSS-scaled: it is redrawn for the current view instead,
               which is what stops the dots growing and blurring as you zoom. -->
          <canvas class="landcv" id="landcv" aria-hidden="true"></canvas>
          <!-- Only the nodes are transformed. -->
          <div class="maplayer" id="maplayer"></div>
          <div class="mapbadge"><span class="dot"></span>Real-time</div>
          <!-- Minimap navigator: appears once you zoom in. -->
          <div class="minimap" id="minimap" data-nopan hidden aria-label="Map navigator - drag to pan">
            <canvas id="minicv"></canvas>
            <div class="minirect" id="minirect"></div>
          </div>
          <!-- Text is set by the map script, which knows the platform modifier.
               Kept out of the markup so JS-disabled visitors are not told the
               map is interactive when it isn't. -->
          <div class="maphint" id="maphint" hidden></div>
          <div class="mapzoom" data-nopan>
            <button id="mz-in" aria-label="Zoom in">+</button>
            <button id="mz-out" aria-label="Zoom out">&minus;</button>
            <button id="mz-fit" aria-label="Reset zoom">&#x26F6;</button>
          </div>
          <!-- Node details, shown when a node is selected. -->
          <div class="nodepanel" id="nodepanel" data-nopan hidden>
            <button class="np-close" id="np-close" aria-label="Clear selection">&times;</button>
            <p class="np-label">Location</p><p class="np-value" id="np-loc"></p>
            <p class="np-label">IP address</p><p class="np-value" id="np-ip"></p>
            <p class="np-label">Version</p><p class="np-value" id="np-ver"></p>
          </div>
        </div>
      </div>
      <p class="mapcount" id="mapcount">Connecting to the C-Layer&hellip;</p>
      <noscript><p class="mapcount">Live map requires JavaScript. The C-Layer is a network of independent community-run nodes worldwide; live node data: https://map.c-layer.certonym.org/api/data</p></noscript>
    </div>

    <h2 class="h2-sub">One network, three specialised chains.</h2>
    <p class="lead">Coming soon: the full family of three purpose-built blockchains, each engineered for what it does best: decentralised identity, stablecoin settlement, and trading, operating as one trusted network.</p>
    <!-- Below 860px this becomes a horizontal snap-scroll row (see global.css).
         tabindex + label because the cards hold no focusable elements, so the
         scroll container itself has to be reachable for a keyboard user to see
         past the first card. -->
    <div class="chains" tabindex="0" role="group" aria-label="The three cDot chains: C-Layer, P-Layer and T-Layer">
      <div class="chain">
        <div class="chain-head">
          <span class="chain-id">C-Layer</span>
        </div>
        <h3>Identity and asset recovery chain</h3>
        <p>A decentralised identity chain for people, businesses, and agents. Cryptographic pseudonyms of verified real identities provide privacy with accountability. Run by nodes around the world for maximum resilience and decentralisation.</p>
        <div class="specs">
          <span>15,000 tx/s, highly parallel</span>
          <span>WASM smart contracts</span>
          <span>20s finality</span>
          <span>Permissionless</span>
          <span>Public and pseudonymous</span>
        </div>
      </div>
      <div class="chain">
        <div class="chain-head">
          <span class="chain-id">P-Layer</span>
          <span class="chain-soon">Launching soon</span>
        </div>
        <h3>Settlement chain</h3>
        <p>Engineered for high-throughput, low-cost global stablecoin settlement and truly programmable money, with native on- and off-ramping. Agentic transactions supported with verifiable, revocable permissions.</p>
        <div class="specs">
          <span>30,000 tx/s</span>
          <span>Finality &lt;1s</span>
          <span>Byzantine security 45%</span>
        </div>
      </div>
      <div class="chain">
        <div class="chain-head">
          <span class="chain-id">T-Layer</span>
          <span class="chain-soon">Launching soon</span>
        </div>
        <h3>Trading chain</h3>
        <p>A high-performance decentralised exchange, offering stablecoin swaps and perpetual futures in a predictable execution environment.</p>
        <div class="specs">
          <span>30,000 tx/s, native multithreading</span>
          <span>Finality &lt;1s</span>
          <span>Node-permissioned overlay on C-Layer</span>
          <span>Private and accountable</span>
          <span>Native NASDAQ-like matching engine</span>
        </div>
      </div>
    </div>
  </div>
</section>

<div class="divider"></div>

<section id="contact">
  <div class="wrap">
    <h2>Want to know more? Get in touch.</h2>
    <form id="contactForm">
    <div class="contact-grid">
        <div class="contact-fields">
          <div class="field">
            <label for="cf-email">Email</label>
            <input id="cf-email" type="email" name="email" autocomplete="email" required>
          </div>
          <div class="field">
            <label for="cf-msg">Message</label>
            <textarea id="cf-msg" name="message" maxlength="5000" required></textarea>
          </div>
          <!-- Honeypot: hidden from people, filled in by bots. -->
          <input class="cf-honeypot" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true">
          <!-- Replaces the fields above on success; also carries error text. -->
          <p class="cf-status" id="cf-status" role="status" aria-live="polite" tabindex="-1"></p>
        </div>
      <noscript>
        <p class="cf-status is-error">This form needs JavaScript. Please email
        <a href="mailto:info@certonymity.com">info@certonymity.com</a> instead.</p>
      </noscript>
      <div class="addr">
        <p>cDot — built by Certonymity</p>
        <p><a href="mailto:info@certonymity.com">info@certonymity.com</a></p>
        <p>Certonymity Ltd<br>86-87 Campden Street<br>London<br>W8 7EN</p>
      </div>
    </div>
    <button class="btn btn-primary" type="submit" style="margin-top:18px">Send message</button>
    </form>
  </div>
</section>


<!-- Contact form. POSTs to the Google Apps Script in scripts/contact-form.gs,
     which records the enquiry in a sheet and emails the team. That script is a
     separate deployment from the c.Email one - see its header comment. -->
<script is:inline>
(function(){
  /* Public by design - see the header comment in scripts/contact-form.gs.
     Replace with the /exec URL of the deployed cDot contact-form script. */
  const CONTACT_FORM_URL =
    'https://script.google.com/macros/s/AKfycbzkT4I_iMLiBBKRZeKdSEU2ohJVpfOFd4UA-tk2ss4p2YddFDbvU1OFPnjHcr0RaOHdUA/exec';

  const form = document.getElementById('contactForm');
  const statusEl = document.getElementById('cf-status');
  const button = form.querySelector('button[type="submit"]');
  const fields = form.querySelectorAll('.contact-fields .field, .cf-honeypot');
  let sending = false;

  /* The status line stays in the DOM and is emptied rather than hidden: a
     display:none live region is not monitored, so un-hiding and filling it in
     one task announces unreliably. */
  function show(message, isError){
    statusEl.textContent = message;
    statusEl.classList.toggle('is-error', !!isError);
    /* Errors move focus, so a screen-reader user is not left waiting for an
       announcement that may not arrive. */
    if(isError) statusEl.focus();
  }

  /* On success the fields and the button go away entirely, so there is no live
     Send button sitting under a thank-you message inviting a second submission. */
  function succeed(message){
    fields.forEach(function(el){ el.hidden = true; });
    button.hidden = true;
    show(message, false);
  }

  function fail(message){
    show(message || 'Something went wrong. Please try again, or email us directly at info@certonymity.com.', true);
    sending = false;
    button.disabled = false;
    button.textContent = 'Send message';
  }

  form.addEventListener('submit', async function(e){
    e.preventDefault();
    if (sending) return;

    /* Better to say so than to POST into the void and report success. */
    if (!CONTACT_FORM_URL) {
      return fail('This form is not connected yet. Please email us directly at info@certonymity.com.');
    }

    /* Sending state lives on the button only. Putting it in the status line too
       would shift the layout mid-submit, since the status sits in the field column. */
    sending = true;
    button.disabled = true;
    button.textContent = 'Sending…';
    statusEl.textContent = '';

    try {
      /* No Content-Type header on purpose. Setting one makes this a preflighted
         request, and Apps Script does not answer the OPTIONS probe, so the whole
         submission fails before it starts. Sent as text/plain it is a "simple
         request" and goes straight through; doPost reads the raw body regardless. */
      /* Without a timeout a stalled connection leaves the button disabled on
         "Sending…" forever, with no way to retry. */
      const response = await fetch(CONTACT_FORM_URL, {
        signal: AbortSignal.timeout(15000),
        method: 'POST',
        body: JSON.stringify({
          email: document.getElementById('cf-email').value.trim(),
          message: document.getElementById('cf-msg').value.trim(),
          website: form.querySelector('[name="website"]').value
        })
      });
      const result = await response.json().catch(function(){ return null; });
      /* Only confirm what the server actually confirmed. */
      if (!response.ok || !result || !result.ok) return fail(result && result.error);

      succeed('Thanks — your message is on its way. We’ll reply to the address you gave us.');
    } catch (err) {
      fail();
    }
  });
})();
</script>

<!-- Live C-Layer map - implementation and rationale in public/assets/map.js.
     Served from public/ rather than inlined to keep the page's prose dominant
     in its markup; `defer` so the elements it queries have parsed. -->
<script src="/assets/map.js" defer></script>

<!-- C-Layer node signup. Ported verbatim from cdot.app, which ports it in turn
     from c.email-website: all three run the same form against the same sheet,
     so a signup from any of them lands in one place. Keep them in step. -->
<script is:inline>
(function(){
  /* The Apps Script web app that records signups. Public by design: it only
     ever appends a row and exposes no way to read the sheet back, so shipping
     it to the browser costs nothing worse than the odd junk row. A SEPARATE
     deployment from the contact form above. */
  const CLAYER_SIGNUP_URL =
    'https://script.google.com/macros/s/AKfycbzoWtxvKHs5oFSKra8olCmpMUGENdc9qlsNGvpeP9UCwYY8nMjMBafhFOvyDpqpkz0KvQ/exec';

  const form = document.getElementById('clayerForm');
  const statusEl = document.getElementById('clayer-status');
  if (!form || !statusEl) return;
  const button = form.querySelector('button[type="submit"]');
  let sending = false;

  function fail(message){
    statusEl.textContent = message || 'Something went wrong. Please try again.';
    statusEl.classList.add('is-error');
    sending = false;
    button.disabled = false;
    button.textContent = 'Register your interest';
  }

  form.addEventListener('submit', async function(e){
    e.preventDefault();
    if (sending) return;

    sending = true;
    button.disabled = true;
    button.textContent = 'Registering…';
    statusEl.textContent = '';
    statusEl.classList.remove('is-error');

    const data = new FormData(form);
    try {
      /* No Content-Type header on purpose. Setting one makes this a preflighted
         request, and Apps Script does not answer the OPTIONS probe, so the whole
         submission fails before it starts. Sent as text/plain it is a "simple
         request" and goes straight through; doPost reads the raw body regardless. */
      /* Without a timeout a stalled connection leaves the button disabled on
         "Registering…" forever, with no way to retry. */
      const response = await fetch(CLAYER_SIGNUP_URL, {
        signal: AbortSignal.timeout(15000),
        method: 'POST',
        body: JSON.stringify({ email: data.get('email'), website: data.get('website') })
      });
      const result = await response.json().catch(function(){ return null; });
      /* Only confirm what the server actually confirmed. */
      if (!response.ok || !result || !result.ok) return fail(result && result.error);

      /* The form goes away on success, so there is no live Register button left
         under a thank-you message inviting a second submission. */
      form.hidden = true;
      statusEl.textContent = 'Thanks — we’ll be in touch!';
      /* Only fail() used to put the label back, so a successful submission left
         the button reading "Registering…" forever. Normally invisible, since
         the form is hidden on the line above - but not always: `hidden` loses
         to any display rule on .node-form, the two paint in the same frame so a
         slow machine shows the stale label first, and a screen reader walking
         back over the region still announces it. Reset it on both paths. */
      sending = false;
      button.disabled = false;
      button.textContent = 'Register your interest';
    } catch (err) {
      fail();
    }
  });
})();
</script>

</Layout>
