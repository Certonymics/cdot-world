---
import { company, sites, registrationLine } from "../data/company.mjs";
import { blogLive, blogPath } from "../data/blog.mjs";

/* The year is the build's, so it moves on the first deploy of a new year. */
const year = new Date().getFullYear();

/* Footer entries. One with an `href` is a link (`external` opens it in a new tab); one without is a "Coming soon"
   label, because there is nothing to link to yet. The Blog gets its href by itself
   when it is switched on in src/data/blog.mjs. */
const links = [
  { id: "team", label: "Team", href: "/team/" },
  { id: "blog", label: "Blog", href: blogLive ? blogPath : undefined },
  { id: "privacy", label: "Privacy", href: "/privacy/" },
  { id: "terms", label: "Terms", href: "/terms/" },
  { id: "contact", label: "Contact", href: "/contact/" },
];
---
<footer>
  <div class="wrap">
    <div class="foot">
      <svg class="foot-mark" role="img" aria-label="cDot"><use href="#cdot-logo"/></svg>
      <div class="foot-stack">
        <!-- A label with no href is not a link: focusable so the "Coming soon" tip also
             shows for keyboard and touch users, not only on mouse hover. -->
        {links.map((item) => item.href ? (
          <a class="foot-link" href={item.href} {...(item.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}>{item.label}</a>
        ) : (
          <span class="foot-link foot-soon" tabindex="0" aria-describedby={`${item.id}-soon`}>
            {item.label}
            <span class="soon-tip" id={`${item.id}-soon`} role="tooltip">Coming soon</span>
          </span>
        ))}
      </div>
    </div>
    <div class="foot-legal">
      <p>© {year} <a class="foot-link" href={sites.company.url} target="_blank" rel="noopener noreferrer">{company.legalName}</a></p>
      <p>{registrationLine}</p>
      <p>cDot is technical infrastructure. Any regulated activities, including banking and payments, are performed by licensed partners.</p>
    </div>
  </div>
</footer>
