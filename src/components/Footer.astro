---
import { company, sites } from "../data/company.mjs";
import { blogLive, blogPath } from "../data/blog.mjs";
import { SOCIALS } from "../data/socials.mjs";

/* The year is the build's, so it moves on the first deploy of a new year. */
const year = new Date().getFullYear();

/* Footer entries. One with an `href` is a link (`external` opens it in a new tab); one without is a "Coming soon"
   label, because there is nothing to link to yet. The Blog gets its href by itself
   when it is switched on in src/data/blog.mjs. */
const links = [
  { id: "team", label: "Team", href: "/team/" },
  { id: "press", label: "Press", href: "https://drive.google.com/drive/folders/1OSPZVD3mimEL1NABBoptLuMaIQxL1dOj?usp=drive_link", external: true },
  { id: "blog", label: "Blog", href: blogLive ? blogPath : undefined },
  { id: "privacy", label: "Privacy", href: "/privacy/" },
  { id: "terms", label: "Terms", href: "/terms/" },
  { id: "contact", label: "Contact", href: "/contact/" },
];
---
<footer>
  <div class="wrap">
    <div class="foot">
      <a class="foot-home" href="/">
        <img class="foot-mark" src="/assets/cdot-mark.svg" width="44" height="44" alt="cDot home" />
      </a>
      <!-- Social profiles, straight after the mark. One without an href shows as a
           "Coming soon" label, like the links. -->
      <nav class="foot-social" aria-label="Social media">
        {SOCIALS.map((s) => s.href ? (
          <a class="foot-link foot-soc" href={s.href} target="_blank" rel="me noopener noreferrer" aria-label={s.label}>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={s.d} /></svg>
          </a>
        ) : (
          <span class="foot-link foot-soc foot-soon" tabindex="0" role="img" aria-label={s.label} aria-describedby={`soc-${s.label.toLowerCase()}-soon`}>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={s.d} /></svg>
            <span class="soon-tip" id={`soc-${s.label.toLowerCase()}-soon`} role="tooltip">Coming soon</span>
          </span>
        ))}
      </nav>
      <nav class="foot-stack" aria-label="Footer">
        <!-- A label with no href is not a link: focusable so the "Coming soon" tip also
             shows for keyboard and touch users, not only on mouse hover. -->
        {links.map((item) => item.href ? (
          <a class="foot-link" href={item.href} {...(item.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}>{item.label}</a>
        ) : (
          <span class="foot-link foot-soon" tabindex="0" aria-describedby={`${item.id}-soon`}>
            {item.label}
            <span class="soon-tip" id={`${item.id}-soon`} role="tooltip">Coming soon</span>
          </span>
        ))}
      </nav>
    </div>
    <p class="foot-copy">© {year} <a class="foot-link" href={sites.company.url} target="_blank" rel="noopener noreferrer">{company.legalName}</a></p>
    <p class="foot-note">cDot is technical infrastructure. Any regulated activities, including banking and payments, are performed by licensed partners.</p>
  </div>
</footer>
