---
/* App store download button.
 *
 * One button over both stores rather than a link to whichever platform got
 * listed first, which is how the equivalent control works on c.email-website.
 *
 * Its own dropdown rather than the header's .has-menu: that one deliberately
 * flattens into a permanently-open list below 640px, which is right for a nav
 * sheet and wrong for a button - both store panels would hang open on mobile.
 */
interface Props {
  /** Button label. */
  label: string;
  /** Unique per page - wires the button to its panel via aria-controls. */
  id: string;
  /** Overrides the menu wording; the links themselves never change. */
  itemLabels?: [string, string];
  /** Optional third item under the two stores - currently the Chrome
   *  extension. Hidden below 640px, since a phone cannot install one. */
  extra?: { label: string; href: string };
}
const { label, id, itemLabels = ["App Store", "Google Play"], extra } = Astro.props;

const IOS = "https://apps.apple.com/gb/app/c-email-secure-email/id6787208131";
const ANDROID = "https://play.google.com/store/apps/details?id=org.certonym.c.email&hl=en_GB";

/* The real store marks, taken from react-icons' Fa set in c.email-website -
   the same icons that site uses. Lifted rather than redrawn: an approximated
   brand logo reads as a mistake. The two carry different viewBoxes, so they
   are sized by height with width:auto to keep each one's proportions. */
const APPLE = {
  box: "0 0 384 512",
  d: "M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z",
};
const CHROME = {
  box: "0 0 496 512",
  d: "M131.5 217.5L55.1 100.1c47.6-59.2 119-91.8 192-92.1 42.3-.3 85.5 10.5 124.8 33.2 43.4 25.2 76.4 61.4 97.4 103L264 133.4c-58.1-3.4-113.4 29.3-132.5 84.1zm32.9 38.5c0 46.2 37.4 83.6 83.6 83.6s83.6-37.4 83.6-83.6-37.4-83.6-83.6-83.6-83.6 37.3-83.6 83.6zm314.9-89.2L339.6 174c37.9 44.3 38.5 108.2 6.6 157.2L234.1 503.6c46.5 2.5 94.4-7.7 137.8-32.9 107.4-62 150.9-192 107.4-303.9zM133.7 303.6L40.4 120.1C14.9 159.1 0 205.9 0 256c0 124 90.8 226.7 209.5 244.9l63.7-124.8c-57.6 10.8-113.2-20.8-139.5-72.5z",
};
const PLAY = {
  box: "0 0 512 512",
  d: "M325.3 234.3L104.6 13l280.8 161.2-60.1 60.1zM47 0C34 6.8 25.3 19.2 25.3 35.3v441.3c0 16.1 8.7 28.5 21.7 35.3l256.6-256L47 0zm425.2 225.6l-58.9-34.1-65.7 64.5 65.7 64.5 60.1-34.1c18-14.3 18-46.5-1.2-60.8zM104.6 499l280.8-161.2-60.1-60.1L104.6 499z",
};
---

<div class="dl">
  <button
    class="btn btn-primary dl-btn"
    type="button"
    aria-expanded="false"
    aria-haspopup="true"
    aria-controls={id}
  >
    <svg class="dl-ico" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3" />
    </svg>
    {label}
    <svg class="dl-chev" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9.5l6 6 6-6" /></svg>
  </button>
  <div class="dl-menu" id={id}>
    <a href={IOS} target="_blank" rel="noopener noreferrer">
      <svg class="dl-brand" viewBox={APPLE.box} aria-hidden="true"><path d={APPLE.d} /></svg>
      {itemLabels[0]}
    </a>
    <a href={ANDROID} target="_blank" rel="noopener noreferrer">
      <svg class="dl-brand" viewBox={PLAY.box} aria-hidden="true"><path d={PLAY.d} /></svg>
      {itemLabels[1]}
    </a>
    {extra && (
      <a class="dl-desktop" href={extra.href} target="_blank" rel="noopener noreferrer">
        <svg class="dl-brand" viewBox={CHROME.box} aria-hidden="true"><path d={CHROME.d} /></svg>
        {extra.label}
      </a>
    )}
  </div>
</div>

<style>
  /* inline-flex on the wrapper so the button fills it. As a flex item of
     .hero-ctas the wrapper stretches to the row; without this the button keeps
     its own height inside a stretched box and ends up short. */
  .dl{position:relative;display:inline-flex}
  .dl-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;width:100%}
  .dl-ico{width:15px;height:15px}
  .dl-chev{width:13px;height:13px;transition:transform .2s}
  .dl-btn svg{fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
  .dl.is-open .dl-chev{transform:rotate(180deg)}
  .dl-menu{
    display:none;position:absolute;left:0;top:100%;margin-top:10px;min-width:200px;z-index:30;
    background:var(--bg-1);border:1px solid var(--line);border-radius:12px;padding:6px;
    box-shadow:var(--shadow-card);
  }
  .dl.is-open .dl-menu{display:block}
  .dl-menu a{
    display:flex;align-items:center;gap:10px;
    padding:9px 12px;border-radius:8px;text-decoration:none;
    color:var(--ink-dim);font-size:14.5px;white-space:nowrap;
    transition:background-color .2s,color .2s;
  }
  .dl-menu a:hover{background:rgba(var(--brand-rgb),.10);color:var(--ink)}
  .dl-menu a:focus-visible{outline:2px solid var(--cyan);outline-offset:-2px}
  /* Filled, unlike the chevron and arrow on the button itself. */
  .dl-brand{height:15px;width:auto;flex-shrink:0;fill:currentColor;stroke:none}
  /* A phone cannot install a browser extension, so the item goes rather than
     sitting there as a dead end. */
  @media(max-width:640px){.dl-desktop{display:none}}
</style>

<script is:inline>
(function(){
  /* This binds every .dl on the page at once, so a page holding two of these
     would wire each one twice over and have the second handler undo the first.
     Astro does not de-duplicate is:inline blocks, so the guard does.

     And it must WAIT for the document. An inline script runs where it sits in
     the markup, so the first copy would otherwise run while only the dropdown
     above it exists, bind that one, set the guard - and every later dropdown on
     the page would be left with no handler at all, a button that looks live and
     does nothing. Deferring to DOMContentLoaded means whichever copy claims the
     guard sees all of them. */
  if (window.__cdotStoreDropdown) return;
  window.__cdotStoreDropdown = true;

  function init(){
  var dls = Array.prototype.slice.call(document.querySelectorAll('.dl'));
  if (!dls.length) return;

  function setOpen(dl, open){
    dl.classList.toggle('is-open', open);
    dl.querySelector('.dl-btn').setAttribute('aria-expanded', open ? 'true' : 'false');
  }
  function closeAll(except){
    dls.forEach(function(d){ if (d !== except) setOpen(d, false); });
  }

  dls.forEach(function(dl){
    dl.querySelector('.dl-btn').addEventListener('click', function(e){
      /* Without this the document handler below closes it again on the same click. */
      e.stopPropagation();
      var open = !dl.classList.contains('is-open');
      closeAll(dl);
      setOpen(dl, open);
    });
  });

  document.addEventListener('click', function(){ closeAll(); });
  document.addEventListener('keydown', function(e){
    if (e.key !== 'Escape') return;
    /* Hand focus back to the button that opened it, or Escape strands the
       keyboard user inside a panel that no longer exists. */
    var open = dls.filter(function(d){ return d.classList.contains('is-open'); })[0];
    if (open) open.querySelector('.dl-btn').focus();
    closeAll();
  });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>
