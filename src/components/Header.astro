---
const tagline = "Secure identity, communication and payments";

/* Top nav. An item with `children` renders as a dropdown, anything else as a
   plain link - so adding or removing a menu is a data change, not a markup one. */
const navItems = [
  {
    label: "Product",
    children: [
      { label: "Identity", href: "/product/c-id" },
      { label: "Email", href: "/product/c-email" },
      { label: "Chat", href: "/product/c-chat" },
      { label: "Payments", href: "/product/c-pay" },
      { label: "Vault", href: "/product/c-vault" },
    ],
  },
  { label: "Network", href: "/network" },
  { label: "FAQ", href: "/faq" },
  { label: "About", href: "/about" },
];
---
<header>
  <div class="wrap nav">
    <a class="brand" href="/">
      <svg class="logomark" role="img" aria-label="cDot"><use href="#cdot-logo"/></svg>
      <span class="tag">{tagline}</span>
    </a>
    <nav id="main-nav">
      {navItems.map((item) =>
        item.children ? (
          <div class="has-menu">
            {/* A button, not a link: it has no destination of its own, and the
                five products are the only things under it. */}
            <button
              class="menu-btn"
              type="button"
              aria-expanded="false"
              aria-controls={`menu-${item.label.toLowerCase()}`}
            >
              {item.label}
              <svg class="chev" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M6 9.5l6 6 6-6" />
              </svg>
            </button>
            {/* Always in the DOM - hidden with display, not removed - so the
                product links stay crawlable and are there for a keyboard user
                the moment the menu opens. */}
            <div class="menu" id={`menu-${item.label.toLowerCase()}`}>
              <div class="menu-panel">
                {item.children.map((c) => (
                  <a class="menu-item" href={c.href}>{c.label}</a>
                ))}
              </div>
            </div>
          </div>
        ) : (
          <a class="link" href={item.href}>{item.label}</a>
        )
      )}
    </nav>
    <div class="nav-controls">
      <!-- Which icon shows is decided in CSS, because the theme has three
           states (explicit light, explicit dark, and "follow the OS" where no
           data-theme attribute exists at all). The label is set by script,
           since it has to name the action rather than the current state. -->
      <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Switch theme">
        <svg class="i-sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <circle cx="12" cy="12" r="4.2"/>
          <g stroke-linecap="round">
            <path d="M12 2.4v2.6M12 19v2.6M2.4 12h2.6M19 12h2.6"/>
            <path d="M5.2 5.2l1.9 1.9M16.9 16.9l1.9 1.9M18.8 5.2l-1.9 1.9M7.1 16.9l-1.9 1.9"/>
          </g>
        </svg>
        <svg class="i-moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M20.1 14.6A8.4 8.4 0 0 1 9.4 3.9a8.4 8.4 0 1 0 10.7 10.7z"/>
        </svg>
      </button>
      <button class="burger" id="burger-btn" aria-label="Open menu" aria-expanded="false" aria-controls="main-nav">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<script is:inline>
(function(){
  /* --- mobile nav ------------------------------------------------------- */
  var btn = document.getElementById('burger-btn');
  var nav = document.getElementById('main-nav');
  if (btn && nav) {
    btn.addEventListener('click', function(){
      var open = nav.classList.toggle('is-open');
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      btn.classList.toggle('is-open', open);
    });
    /* Close on nav link tap so the menu doesn't hang open on mobile. This
       catches the product links too - they are <a>s inside the same nav. */
    nav.querySelectorAll('a').forEach(function(a){
      a.addEventListener('click', function(){
        nav.classList.remove('is-open');
        btn.setAttribute('aria-expanded', 'false');
        btn.classList.remove('is-open');
      });
    });
  }

  /* --- dropdowns -------------------------------------------------------- */
  /* Open state lives in a class, and CSS decides what that means per
     breakpoint: a floating panel on desktop, and on mobile nothing at all -
     there the submenu is permanently expanded under its label, because a
     tap-to-open second level inside an already-tapped-open nav is fiddly. */
  var menus = Array.prototype.slice.call(document.querySelectorAll('.has-menu'));
  if (menus.length) {
    /* Pointer devices get hover; touch would otherwise fire a phantom
       mouseenter on the tap that opened the menu. */
    var canHover = window.matchMedia('(hover:hover)').matches;

    var setOpen = function(el, open){
      el.classList.toggle('is-open', open);
      el.querySelector('.menu-btn').setAttribute('aria-expanded', open ? 'true' : 'false');
    };
    var closeAll = function(except){
      menus.forEach(function(m){ if (m !== except) setOpen(m, false); });
    };

    menus.forEach(function(m){
      m.querySelector('.menu-btn').addEventListener('click', function(e){
        /* Without this the document handler below would close it again in the
           same click. */
        e.stopPropagation();
        var open = !m.classList.contains('is-open');
        closeAll(m);
        setOpen(m, open);
      });
      if (canHover) {
        m.addEventListener('mouseenter', function(){ closeAll(m); setOpen(m, true); });
        m.addEventListener('mouseleave', function(){ setOpen(m, false); });
      }
    });

    document.addEventListener('click', function(){ closeAll(); });
    document.addEventListener('keydown', function(e){
      if (e.key !== 'Escape') return;
      /* Send focus back to the button that opened it, or the close leaves the
         keyboard user's position inside a panel that no longer exists. */
      var open = menus.filter(function(m){ return m.classList.contains('is-open'); })[0];
      if (open) open.querySelector('.menu-btn').focus();
      closeAll();
    });
  }

  /* --- theme toggle ----------------------------------------------------- */
  /* window.__cdotTheme is defined by the blocking script in Layout.astro,
     which has already applied the stored choice before first paint. */
  var toggle = document.getElementById('theme-toggle');
  if (!toggle || !window.__cdotTheme) return;
  var T = window.__cdotTheme;

  function label(){
    /* Name the action, not the state: a button reading "Dark" is ambiguous
       about whether that is what it does or what you have. */
    var next = T.effective() === 'dark' ? 'light' : 'dark';
    toggle.setAttribute('aria-label', 'Switch to ' + next + ' theme');
    toggle.setAttribute('title', 'Switch to ' + next + ' theme');
  }

  toggle.addEventListener('click', function(){
    T.set(T.effective() === 'dark' ? 'light' : 'dark');
    label();
  });

  /* No prefers-color-scheme listener: dark is unconditional and light is opt-in,
     so flipping the OS theme is not something this page should react to. */
  label();
})();
</script>
