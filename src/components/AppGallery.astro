<script is:inline>
(function(){
  var tabs  = Array.prototype.slice.call(document.querySelectorAll('.ag-tab'));
  var units = Array.prototype.slice.call(document.querySelectorAll('.ag-unit'));
  var infos = Array.prototype.slice.call(document.querySelectorAll('.ag-info-item'));
  if (!tabs.length || !units.length) return;

  var KEYS = tabs.map(function(t){ return t.dataset.tab; });
  var n = KEYS.length;

  /* Signed distance from active, wrapping both ways - so stepping off either
     end of the list slides in from the opposite side rather than jumping the
     full width of the stage. Mirrors the `off` helper in the frontmatter. */
  function offset(i, active){
    var d = (i - active + n) % n;
    return d > n / 2 ? d - n : d;
  }

  function select(key, focus){
    var active = KEYS.indexOf(key);
    if (active < 0) return;

    tabs.forEach(function(t, i){
      var on = i === active;
      t.setAttribute('aria-selected', on ? 'true' : 'false');
      /* Roving tabindex: the tablist is one stop, arrows move within it. */
      t.tabIndex = on ? 0 : -1;
      if (on && focus) t.focus();
    });
    units.forEach(function(u, i){ u.dataset.off = offset(i, active); });
    infos.forEach(function(el){
      el.classList.toggle('is-active', el.dataset.info === key);
    });
  }

  /* Click only. Hover used to select as well, but with the copy swapping and
     five screens sliding on every pill the pointer crossed, simply moving
     across the row set the whole section going. Hover keeps its colour change
     on the pill; changing what is shown is a decision, so it takes a click. */
  tabs.forEach(function(t){
    t.addEventListener('click', function(){ select(t.dataset.tab, false); });
  });

  /* Clicking a neighbouring screen brings it forward. Only the two either side
     answer - the pair off-stage are pointer-events:none, so a click cannot
     land on a phone that is not visible. */
  units.forEach(function(u){
    u.addEventListener('click', function(){
      if (u.dataset.off !== '0') select(u.dataset.unit, false);
    });
  });

  document.querySelector('.ag-tabs').addEventListener('keydown', function(e){
    var i = tabs.findIndex(function(t){ return t.getAttribute('aria-selected') === 'true'; });
    if (i < 0) return;
    var next = e.key === 'ArrowRight' ? i + 1
             : e.key === 'ArrowLeft'  ? i - 1
             : e.key === 'Home'       ? 0
             : e.key === 'End'        ? tabs.length - 1
             : -1;
    if (next === -1) return;
    e.preventDefault();
    select(tabs[(next + tabs.length) % tabs.length].dataset.tab, true);
  });
})();
</script>
