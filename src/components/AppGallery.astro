---
/* App gallery. Ported from AppGallery.jsx in 'Cdot site (main)'.
 *
 * THE PHONE SCREENS ARE DELIBERATELY LIGHT IN BOTH THEMES. They depict the cDot
 * app's own interface, which is light - so they are a picture of a product, the
 * way a screenshot would be, not part of this site's chrome. Theming them to
 * follow the site would mean inventing a dark version of an app that does not
 * have one. Everything around them - heading, tabs, feature pills - is themed
 * normally, so the section still belongs to whichever scheme is on.
 *
 * Styles are scoped to this component rather than living in global.css. That
 * breaks the repo's usual habit, but a phone mockup's internals are the one
 * thing on the site that genuinely should not be reachable from anywhere else,
 * and it keeps ~150 lines of decorative CSS out of the global sheet.
 */
const TABS = [
  { key: "identity", name: "Identity", copy: "Share proofs of attributes, not personal data." },
  { key: "email",    name: "Email",    copy: "Encrypted, authenticated email with your existing account." },
  { key: "chat",     name: "Chat",     copy: "Messaging without surveillance, bots, or impersonation." },
  { key: "pay",      name: "Pay",      copy: "Private, instant, borderless payments." },
  { key: "vault",    name: "Vault",    copy: "Store any asset and prove ownership cryptographically." },
];

/* Icon bodies only - the <svg> wrapper is in the markup, so every icon gets the
   same box and stroke without repeating the attributes fifteen times. */
const I = {
  link:   '<path d="M10 13a5 5 0 007.54.54l3-3a5 5 0 00-7.07-7.07l-1.72 1.71M14 11a5 5 0 00-7.54-.54l-3 3a5 5 0 007.07 7.07l1.71-1.71"/>',
  shield: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>',
  user:   '<path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2M12 11a4 4 0 100-8 4 4 0 000 8z"/>',
  lock:   '<path d="M3 11h18v10H3zM7 11V7a5 5 0 0110 0v4"/>',
  check:  '<path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>',
  face:   '<path d="M9 10h.01M15 10h.01M12 16c1.5 0 2.5-.5 3-1.5"/><path d="M3 7V5a2 2 0 012-2h2M17 3h2a2 2 0 012 2v2M21 17v2a2 2 0 01-2 2h-2M7 21H5a2 2 0 01-2-2v-2"/>',
  bolt:   '<path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>',
  apps:   '<path d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zm10 0a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zm10 0a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/>',
  at:     '<path d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207"/>',
  pin:    '<path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>',
  inbox:  '<path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>',
  chat:   '<path d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>',
  wallet: '<path d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>',
  burger: '<line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>',
  search: '<circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>',
};

const PILLS = {
  identity: [["link", "Reusable identity proofs"], ["shield", "No personal data shared"], ["user", "Anonymous by default"]],
  email:    [["lock", "End-to-end encrypted"], ["check", "Anti-spam authentication"], ["face", "Face unlock for sensitive emails"]],
  chat:     [["lock", "End-to-end encrypted"], ["shield", "Verified senders"], ["user", "No email or phone number needed"]],
  pay:      [["bolt", "Instant, borderless payments"], ["apps", "Transactions encrypted on-chain"], ["at", "Pay with only your email"]],
  vault:    [["shield", "Store and protect any asset"], ["pin", "Prove ownership with your identity"], ["lock", "Extra security for high-value assets"]],
};

/* Signed distance from the active tab, wrapping both ways: with five screens
   that gives 0, ±1, ±2, so the two furthest away sit off-stage whichever
   direction you came from. Rendered for tab 0; the script recomputes it. */
const off = (i, active = 0) => {
  const d = (i - active + TABS.length) % TABS.length;
  return d > TABS.length / 2 ? d - TABS.length : d;
};

/* Which bottom-nav item is lit on each screen. */
const NAV = [["inbox", "Inbox"], ["chat", "Chat"], ["wallet", "Wallet"], ["apps", "Apps"], ["shield", "Vault"]];
const NAV_ON = { identity: 0, email: 0, chat: 1, pay: 2, vault: 4 };

const EMAILS = [
  ["SM", "Sophie Martin", "29 May", "7a21f0::secured payload", "enc://v1:4c9f8e7a118b5d7f33f2", null, true],
  ["AC", "Alice Chen", "2 Jun", "Security Update – Mandatory Action", "URGENT: Please update your password…", null, true],
  ["RM", "Robert Martinez", "1 Jun", "Mission: Website Redesign – 2,500 USDC", "New mission available: Redesign company…", "Pending validation", true],
  ["LT", "Lisa Thompson", "31 May", "Mission: Mobile App – 8,000 USDC", "New mission available: Develop mobile app…", "Pending payment", true],
  ["TA", "Thomas Anderson", "30 May", "Freelance Opportunity: UI/UX Design", "Hello! I saw your work on LinkedIn…", null, false],
];
---

<section id="apps">
  <div class="wrap">
    <h2>One app to protect you, wherever you go</h2>
    <p class="lead">Whatever you need to do, do it privately with cDot.</p>

    <div class="ag-layout">
      <div class="ag-tabs" role="tablist" aria-label="cDot app features">
      {TABS.map((t, i) => (
        <button
          class="ag-tab"
          type="button"
          role="tab"
          data-tab={t.key}
          id={`ag-tab-${t.key}`}
          aria-selected={i === 0 ? "true" : "false"}
          aria-controls={`ag-panel-${t.key}`}
          tabindex={i === 0 ? 0 : -1}
          data-label={t.name}
        >{t.name}</button>
      ))}
      </div>

      <!-- Every tab's copy and pills are rendered up front and revealed by CSS
           rather than built on demand: nothing to rebuild on each change, and
           the text is all in the markup for a crawler. -->
      <div class="ag-info">
        {TABS.map((t, i) => (
          <div class:list={["ag-info-item", { "is-active": i === 0 }]} data-info={t.key}>
            <p class="ag-copy">{t.copy}</p>
            <ul class="ag-feats">
              {PILLS[t.key].map(([ic, label]) => (
                <li><svg viewBox="0 0 24 24" set:html={I[ic]} />{label}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>

    <!-- Carousel. All five screens stay in the DOM; data-off is each one's
         signed distance from the active tab, wrapping at both ends, and CSS
         turns that into a position. Only -1/0/+1 are visible - five will not
         fit at a readable size, and the tab list above is what tells you where
         in the five you are. -->
    <div class="ag-stage">
      {TABS.map((t, i) => (
        <div
          class="ag-unit"
          data-unit={t.key}
          data-off={off(i)}
          id={`ag-panel-${t.key}`}
          role="tabpanel"
          aria-labelledby={`ag-tab-${t.key}`}
        >
          <div class="ag-phone">
            <div class="ag-status"><span>9:41</span></div>

            <div class="ag-appbar">
              <span class="ag-ic"><svg viewBox="0 0 24 24" set:html={I.burger} /></span>
              <span class="ag-avatar">JD</span>
              <span class="ag-who">Jean Dupont +3 <span class="ag-caret">&#9662;</span></span>
              <span class="ag-ic">
                {t.key === "pay" || t.key === "vault"
                  ? <b class="ag-cur">$ <span class="ag-caret">&#9662;</span></b>
                  : <svg viewBox="0 0 24 24" set:html={I.search} />}
              </span>
            </div>

            {t.key === "identity" && (
              <div class="ag-body ag-pad">
                <p class="ag-lbl">Select proofs to share:</p>
                <div class="ag-stack">
                  {["Age 16 or older", "Age 18 or older", "Age 21 or older"].map((p, n) => (
                    <div class="ag-opt">
                      <span class:list={["ag-radio", { on: n === 1 }]}></span>
                      <span>{p}</span>
                    </div>
                  ))}
                </div>
                <div class="ag-cta">Share proof</div>
              </div>
            )}

            {t.key === "email" && (
              <div class="ag-body">
                <div class="ag-filters">
                  <span class="ag-chip on">All</span>
                  <span class="ag-chip">Secure</span>
                  <span class="ag-chip">Unsecure</span>
                </div>
                <div class="ag-list">
                  {EMAILS.map(([ini, name, date, subj, prev, tag, ok]) => (
                    <div class="ag-mail">
                      <span class:list={["ag-avatar sm", { warn: !ok }]}>{ini}</span>
                      <div class="ag-mail-b">
                        <div class="ag-row">
                          <span class="ag-name">{name}{ok && <i class="ag-tick">&#10003;</i>}</span>
                          <span class="ag-date">{date}</span>
                        </div>
                        <div class="ag-subj">{subj}</div>
                        <div class="ag-prev">{prev}</div>
                        {tag && <div class="ag-tag">{tag}</div>}
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            )}

            {t.key === "chat" && (
              <div class="ag-body ag-pad ag-tint">
                <div class="ag-chead">
                  <span class="ag-avatar grn">ML</span>
                  <span class="ag-meta">Verified identity &middot; <i class="ag-enc">Encrypted</i></span>
                </div>
                <div class="ag-msg">Did the new keys sync to your phone?</div>
                <div class="ag-msg me">Yep &mdash; fully encrypted on both ends.</div>
                <div class="ag-msg">Perfect. No one else can read this.</div>
              </div>
            )}

            {t.key === "pay" && (
              <div class="ag-body ag-pad">
                <div class="ag-subtabs"><span class="on">Wallet</span><span>Activity</span></div>
                <div class="ag-card">
                  <p class="ag-lbl">Send payment</p>
                  <div class="ag-chead">
                    <span class="ag-avatar">JR</span>
                    <span>
                      <b class="ag-name">Jordan Reyes <i class="ag-tick">&#10003;</i></b>
                      <span class="ag-meta">jordan@cdot</span>
                    </span>
                  </div>
                  <div class="ag-amt"><b>0.25 ETH</b><span class="ag-meta">&#8776; $812.40</span></div>
                  <div class="ag-ok">&#10003; Signed &amp; verifiable on-chain</div>
                  <div class="ag-cta">Send securely</div>
                </div>
              </div>
            )}

            {t.key === "vault" && (
              <div class="ag-body ag-pad">
                <p class="ag-lbl">Account recovery</p>
                <p class="ag-meta">Verify it&rsquo;s really you</p>
                <div class="ag-face">
                  <svg viewBox="0 0 24 24" set:html={I.user} />
                  <i class="ag-badge">&#10003;</i>
                </div>
                <div class="ag-checks">
                  {["Face match & liveness", "Biometric check passed", "Keys restored on this device"].map((c) => (
                    <div class="ag-check">
                      <span class="ag-sq"><svg viewBox="0 0 24 24" set:html={I.shield} /></span>
                      <span>{c}</span>
                      <i class="ag-yes">&#10003;</i>
                    </div>
                  ))}
                </div>
              </div>
            )}

            <div class="ag-nav">
              {NAV.map(([ic, label], n) => (
                <span class:list={["ag-nav-i", { on: n === NAV_ON[t.key] }]}>
                  <svg viewBox="0 0 24 24" set:html={I[ic]} />
                  <span>{label}</span>
                </span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
    </div>
  </div>
</section>

<style>
  /* --- section chrome: themed and left-aligned like the rest of the site --- */
  /* Two rows, two columns: the pills and the copy stack down the left, and the
     stage spans both rows on the right. Spanning is what lifts the screens up
     level with the top of the pills, rather than starting below them - and it
     does it structurally, so nothing has to be nudged by a magic offset that
     would drift the moment the pills wrapped to a second line.

     The left column is sized to hold the pill row on one line (they measure
     about 500px all told), which also puts the stage's left edge clear of the
     rightmost pill by the full column gap. */
  .ag-layout{
    /* One value for the space above the pills and the space below them, so the
       row sits equidistant between the standfirst and the copy by construction
       rather than by two numbers that happen to match today. */
    --ag-gap:36px;
    display:grid;
    grid-template-columns:minmax(0,500px) 1fr;
    /* auto 1fr, not auto auto. With two auto rows the grid shares the stage's
       spare height between them, which pushes the pill row down off the top
       line and carries everything under it along too. */
    grid-template-rows:auto 1fr;
    column-gap:48px;align-items:start;margin-top:var(--ag-gap);
  }
  .ag-tabs{grid-column:1;grid-row:1}
  .ag-info{grid-column:1;grid-row:2;align-self:start;margin-top:var(--ag-gap)}
  .ag-stage{grid-column:2;grid-row:1 / span 2}

  /* A row, each pill sized to its own label. */
  .ag-tabs{display:flex;flex-wrap:wrap;gap:8px}
  .ag-tab{
    border-radius:999px;padding:10px 20px;font-size:15px;font-family:inherit;font-weight:500;
    text-align:left;cursor:pointer;
    border:1.5px solid rgba(var(--brand-rgb),.2);
    background:transparent;color:var(--ink-dim);
    transition:color .2s,background-color .2s,border-color .2s;
  }
  /* Every pill silently reserves the width of its own label at weight 600, so
     that selecting one - which bolds it - cannot change its width. It matters
     more at natural widths than it did at a shared one: "Payments" measures
     66.7px at 500 and 70.9px at 600, and that 4px would shove every pill after
     it along the row each time it was picked. */
  .ag-tab::before{
    content:attr(data-label);
    display:block;height:0;overflow:hidden;visibility:hidden;font-weight:600;
  }
  /* Hover and selected are the same translucent brand wash at two strengths,
     borrowed from the feature pills below, and both turn the label brand blue.
     Selected takes a heavier border and weight too, because the two washes
     alone sit close enough that hover would read as selection.

     --cyan, not --brand-text. In light they are the same value (#4A5AE8), so
     this IS the brand blue there; in dark --brand-text is #566AFD, which is
     only 4.57:1 on the background before any wash and cannot clear 4.5:1 at
     15px once one is laid over it - at any alpha. --cyan is the accent-text
     step of the same ramp and is tuned per scheme for exactly this job.

     The .12 is load-bearing: at .16 the light pairing drops to 4.38:1. */
  .ag-tab:hover{color:var(--cyan);border-color:rgba(var(--brand-rgb),.35);
    background:rgba(var(--brand-rgb),.07)}
  .ag-tab[aria-selected="true"]{
    color:var(--cyan);font-weight:600;
    border-color:rgba(var(--brand-rgb),.5);
    background:rgba(var(--brand-rgb),.12);
  }
  .ag-tab:focus-visible{outline:2px solid var(--cyan);outline-offset:3px}

  .ag-info-item{display:none}
  .ag-info-item.is-active{display:block}
  .ag-copy{margin:0;color:var(--ink-dim);font-size:15.5px}

  /* --- stage ------------------------------------------------------------- */
  /* Fixed height because the screens are absolutely positioned: without it the
     stage would collapse and drag the footer up under the phones. */
  .ag-stage{position:relative;height:474px;overflow:hidden;min-width:0}
  .ag-unit{
    position:absolute;top:0;left:50%;
    transition:transform .4s cubic-bezier(.22,.61,.36,1),opacity .4s ease,filter .4s ease;
  }
  .ag-unit[data-off="0"]{transform:translateX(-50%) scale(1);opacity:1;filter:none;z-index:3}
  .ag-unit[data-off="-1"],
  .ag-unit[data-off="1"]{opacity:.34;filter:blur(.6px) grayscale(.35);cursor:pointer;z-index:2}
  /* 148px, not the old 168px: the stage column is narrower now that the pills
     share the row, and at 168 the outer screens ran past its edge and were
     clipped by the overflow. At 148 the spread is 478px inside a 484px column. */
  .ag-unit[data-off="-1"]{transform:translateX(calc(-50% - 148px)) scale(.82)}
  .ag-unit[data-off="1"]{transform:translateX(calc(-50% + 148px)) scale(.82)}
  /* Off-stage. pointer-events:none so a click cannot land on a phone nobody
     can see; they hold nothing focusable, so there is no tab stop to strand. */
  .ag-unit[data-off="-2"],
  .ag-unit[data-off="2"]{opacity:0;pointer-events:none;z-index:1}
  .ag-unit[data-off="-2"]{transform:translateX(calc(-50% - 260px)) scale(.7)}
  .ag-unit[data-off="2"]{transform:translateX(calc(-50% + 260px)) scale(.7)}
  @media(prefers-reduced-motion:reduce){
    .ag-unit{transition:opacity .2s ease}
  }

  /* Below the grid breakpoint the columns stack and the tabs go back to a
     wrapped row: a vertical list of five above a phone pushes the screens off
     the first screenful entirely. */
  @media(max-width:900px){
    /* One column, so the spanning stage becomes a third row and everything
       falls back into source order: pills, copy, screens. */
    .ag-layout{grid-template-columns:1fr;grid-template-rows:auto;row-gap:28px}
    .ag-tabs,.ag-info,.ag-stage{grid-column:1;grid-row:auto}
    .ag-info{margin-top:0}
    .ag-stage{height:454px}
    /* The copy follows the phone it describes once they stack. */
    .ag-info{margin-top:4px}
    .ag-unit[data-off="-1"]{transform:translateX(calc(-50% - 140px)) scale(.8)}
    .ag-unit[data-off="1"]{transform:translateX(calc(-50% + 140px)) scale(.8)}
  }

  /* Plain list, no chrome. As pills these sat directly under the tab pills and
     read as a second row of controls; without the border and fill they are
     what they are, three points of copy. Losing the pill also lets them wrap,
     which the longer ones need in a column this narrow - hence flex-start and
     the nudge on the icon, so it aligns to the first line rather than to the
     centre of a two-line item. */
  .ag-feats{list-style:none;margin:18px 0 0;padding:0;display:flex;flex-direction:column;gap:11px}
  .ag-feats li{
    display:flex;align-items:flex-start;gap:9px;
    font-size:14px;line-height:1.5;color:var(--ink);
  }
  .ag-feats svg{
    width:15px;height:15px;flex-shrink:0;margin-top:3px;
    fill:none;stroke:var(--cyan);stroke-width:2;
  }

  /* --- the phone itself: light in BOTH themes, see the note at the top ----- */
  .ag-phone{
    width:218px;border-radius:20px;overflow:hidden;display:flex;flex-direction:column;
    background:#eef0ff;box-shadow:var(--shadow-card);font-family:inherit;
  }
  .ag-status{display:flex;justify-content:space-between;align-items:center;
    padding:10px 18px 2px;font-size:12px;font-weight:700;color:#111;background:#fff}
  .ag-appbar{display:flex;align-items:center;gap:8px;padding:6px 12px 8px;
    background:#fff;border-bottom:1px solid rgba(0,0,0,.06)}
  .ag-ic{width:26px;height:26px;display:flex;align-items:center;justify-content:center;
    color:#6b7280;flex-shrink:0}
  .ag-ic svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.5}
  .ag-cur{font-size:13px;font-weight:700;color:#374151}
  .ag-caret{color:#9ca3af;font-size:10px}
  .ag-avatar{width:26px;height:26px;border-radius:50%;background:#566afd;display:flex;
    align-items:center;justify-content:center;font-size:9px;font-weight:800;color:#fff;flex-shrink:0}
  .ag-avatar.sm{width:26px;height:26px;font-size:8px;margin-top:1px}
  .ag-avatar.warn{background:#f97316}
  .ag-avatar.grn{width:30px;height:30px;background:#16a34a;font-size:10px}
  .ag-who{font-size:12px;font-weight:600;color:#111;flex:1}

  .ag-body{height:322px;overflow:hidden;background:#fff;display:flex;flex-direction:column}
  .ag-pad{padding:12px}
  .ag-tint{background:#f5f6ff}
  .ag-lbl{font-size:12px;font-weight:600;color:#111;margin:0 0 8px}
  .ag-meta{font-size:10px;color:#9ca3af;display:block}
  .ag-stack{display:flex;flex-direction:column;gap:8px}
  .ag-opt{display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:10px;
    border:1.5px solid rgba(86,106,253,.2);background:#f8f8ff;font-size:11px;font-weight:600;color:#111}
  .ag-radio{width:16px;height:16px;border-radius:50%;border:2px solid #566afd;flex-shrink:0;
    display:flex;align-items:center;justify-content:center}
  .ag-radio.on::after{content:"";width:8px;height:8px;border-radius:50%;background:#566afd}
  .ag-cta{margin-top:auto;background:#566afd;border-radius:10px;padding:9px 0;
    font-size:11px;font-weight:600;color:#fff;text-align:center}

  .ag-filters{display:flex;gap:4px;padding:5px 10px 6px;background:#fff;
    border-bottom:1px solid rgba(0,0,0,.06);flex-shrink:0}
  .ag-chip{border:1px solid #e5e7eb;border-radius:20px;padding:2px 9px;font-size:9px;color:#6b7280}
  .ag-chip.on{border:1.5px solid #566afd;color:#566afd;font-weight:700;padding:2px 10px}
  .ag-list{flex:1;overflow:hidden}
  .ag-mail{display:flex;gap:7px;padding:7px 10px;border-bottom:1px solid #f5f5f5;align-items:flex-start}
  .ag-mail:last-child{border-bottom:0}
  .ag-mail-b{flex:1;min-width:0}
  .ag-row{display:flex;justify-content:space-between;align-items:center}
  .ag-name{font-size:10px;font-weight:700;color:#111;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .ag-tick{color:#566afd;font-style:normal;margin-left:2px}
  .ag-date{font-size:8px;color:#9ca3af;flex-shrink:0;margin-left:4px}
  .ag-subj{font-size:9px;font-weight:600;color:#111;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
